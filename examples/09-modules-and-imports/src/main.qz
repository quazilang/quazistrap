import std.io;
import catalog.Product;
import catalog.discounted_price;

fn main() i32 {
    const keyboard = Product {
        name: "QuaziBoard",
        price: 120,
    };
    const display_name: String = String.from(keyboard.name);
    const price = discounted_price(keyboard, 15);
    io.println("{} costs ${} after discount", display_name.as_str(), price);
    ret 0;
}
