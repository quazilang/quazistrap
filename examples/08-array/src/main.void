import std.io;

fn main() i32 {
    var arr: Array[i32] = Array.new();
    arr.push(10);
    arr.push(20);
    arr.push(30);
    arr.push(40);
    arr.push(50);

    io.println("Array created with 5 elements");

    io.println("arr[0] = {}", arr[0]);
    io.println("arr[2] = {}", arr[2]);
    io.println("arr[4] = {}", arr[4]);

    arr.set(2, 99);
    io.println("After set(2, 99): arr[2] = {}", arr[2]);

    io.println("Length = {}", arr.len());
    io.println("Is empty = {}", arr.is_empty());

    var sum: i32 = 0;
    for i : arr {
        sum += i;
    }
    io.println("Sum of all elements = {}", sum);

    var words: Array[String] = Array.new();
    words.push("hello");
    words.push("from");
    words.push("void");

    io.println("Words array:");
    for word : words {
        io.println(word);
    }

    arr.free();
    words.free();

    io.println("Done!");
    ret 0;
}
