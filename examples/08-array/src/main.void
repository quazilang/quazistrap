import std.io;

fn choose_value(a: i32) i32 {
    if a > 5 {
        ret 67;
    } else if a < 5 {
        ret 52;
    } else {
        ret 42;
    }
}

fn main() i32 {
    var arr: Array[i32] = Array.new();
    arr.push(10);
    arr.push(20);
    arr.push(30);
    arr.push(40);
    arr.push(50);

    io.println("Array created with 5 elements");

    io.println("arr[0] = {}", arr[0]);
    io.println("arr[2] = {}", arr[2]);
    io.println("arr[4] = {}", arr[4]);

    arr.set(2, 99);
    io.println("After set(2, 99): arr[2] = {}", arr[2]);

    arr[2] = 88;
    io.println("After arr[2] = 88: arr[2] = {}", arr[2]);

    io.println("Length = {}", arr.len());
    io.println("Is empty = {}", arr.is_empty());

    var sum: i32 = 0;
    for i : arr {
        sum += i;
    }
    io.println("Sum of all elements = {}", sum);

    var words: Array[str] = Array.from("hello", "from", "void");

    io.println("Words array:");
    for word : &words {
        io.println(word);
    }

    io.println("{}", words.len());

    var n: u64 = 42 as u64;
    io.println("42 as u64 = {}", n);

    io.println("choose(4) = {}", choose_value(4));
    io.println("choose(6) = {}", choose_value(6));
    io.println("choose(5) = {}", choose_value(5));

    io.println("Done!");
    ret 0;
}
