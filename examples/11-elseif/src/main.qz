import std.io;

fn grade(score: u32) str {
    if score >= 90 {
        ret "A";
    } else if score >= 80 {
        ret "B";
    } else if score >= 70 {
        ret "C";
    } else if score >= 60 {
        ret "D";
    } else {
        ret "F";
    }
}

fn main() i32 {
    io.println("Grade mapping:");
    io.println(grade(95));
    io.println(grade(82));
    io.println(grade(76));
    io.println(grade(61));
    io.println(grade(45));
    ret 0;
}
