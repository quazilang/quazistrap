import std.io.println;

fn divide(a: i32, b: i32) Option[i32] {
    if (b == 0) { ret Option.None; }
    ret Option.Some(a / b);
}

enum Shape {
    Circle(f64),
    Rect(f64, f64),
    Triangle(f64, f64),
}

fn print_shape(s: Shape) void {
    match s {
        Shape.Circle(r) => println("circle: area = {}", r * r * 3.14159),
        Shape.Rect(w, h) => println("rectangle: area = {}", w * h),
        Shape.Triangle(b, h) => println("triangle: area = {}", b * h * 0.5),
    };
}

fn main() i32 {
    var r = divide(10, 3);
    if (r.is_some()) {
        println("10 / 3 = {}", r.unwrap());
    }

    var bad = divide(5, 0);
    if (bad.is_none()) {
        println("5 / 0 = undefined");
    }

    print_shape(Shape.Circle(5.0));
    print_shape(Shape.Rect(4.0, 6.0));
    print_shape(Shape.Triangle(3.0, 8.0));

    ret 0;
}
