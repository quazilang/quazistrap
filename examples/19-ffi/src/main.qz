import std.ffi.c_int;

@api("c_roundtrip")
unsafe fn c_roundtrip(left: c_int, right: c_int) c_int;

@export("quazi_multiply")
pub fn multiply(left: c_int, right: c_int) c_int {
    ret left * right;
}

fn main() i32 {
    var result: c_int = 0;
    unsafe {
        result = c_roundtrip(10, 11);
    }
    if (result == 42) {
        ret 0;
    }
    ret 1;
}
