pub struct IniDocument {
    content: String,
}

pub trait ReadableConfig {
    fn parse_string(content: str) void;
}

pub trait WriteableConfig {
    fn stringify() String;
}

impl IniDocument {
    pub fn new() IniDocument {
        ret IniDocument { content: String.new() };
    }

    pub fn get(self: IniDocument, section: str, key: str) String {
        var current_section = String.new();
        var result = String.new();
        var line_start: usize = 0;
        var index: usize = 0;
        const content = self.content.as_str();
        const content_len: usize = content.len();

        for index <= content_len {
            const at_end: bool = index == content_len;
            if at_end || content[index as isize] == 10 {
                const line = content[line_start as isize:index as isize];
                const trimmed = line.trim();

                if !trimmed.is_empty()
                    && !trimmed.starts_with(";")
                    && !trimmed.starts_with("#") {
                    if trimmed.starts_with("[") && trimmed.ends_with("]") {
                        current_section = trimmed[1:-1].trim();
                    } else if current_section.as_str() == section {
                        var separator: isize = -1;
                        var position: usize = 0;
                        for position < trimmed.len() {
                            if trimmed[position as isize] == 61 {
                                separator = position as isize;
                                break;
                            }
                            position++;
                        }

                        if separator >= 0 {
                            const candidate = trimmed[0:separator].trim();
                            if candidate.as_str() == key {
                                result = trimmed[separator + 1:].trim();
                            }
                        }
                    }
                }

                line_start = index + 1;
            }
            index++;
        }

        ret result;
    }

    pub fn contains(self: IniDocument, section: str, key: str) bool {
        var current_section = String.new();
        var line_start: usize = 0;
        var index: usize = 0;
        const content = self.content.as_str();
        const content_len: usize = content.len();

        for index <= content_len {
            const at_end: bool = index == content_len;
            if at_end || content[index as isize] == 10 {
                const line = content[line_start as isize:index as isize];
                const trimmed = line.trim();

                if !trimmed.is_empty()
                    && !trimmed.starts_with(";")
                    && !trimmed.starts_with("#") {
                    if trimmed.starts_with("[") && trimmed.ends_with("]") {
                        current_section = trimmed[1:-1].trim();
                    } else if current_section.as_str() == section {
                        var separator: isize = -1;
                        var position: usize = 0;
                        for position < trimmed.len() {
                            if trimmed[position as isize] == 61 {
                                separator = position as isize;
                                break;
                            }
                            position++;
                        }

                        if separator >= 0 {
                            const candidate = trimmed[0:separator].trim();
                            if candidate.as_str() == key { ret true; }
                        }
                    }
                }

                line_start = index + 1;
            }
            index++;
        }

        ret false;
    }

    pub fn has_section(self: IniDocument, section: str) bool {
        var line_start: usize = 0;
        var index: usize = 0;
        const content = self.content.as_str();
        const content_len: usize = content.len();

        for index <= content_len {
            const at_end: bool = index == content_len;
            if at_end || content[index as isize] == 10 {
                const line = content[line_start as isize:index as isize];
                const trimmed = line.trim();
                if trimmed.starts_with("[") && trimmed.ends_with("]") {
                    const name = trimmed[1:-1].trim();
                    if name.as_str() == section { ret true; }
                }
                line_start = index + 1;
            }
            index++;
        }

        ret false;
    }

    pub fn free(self: IniDocument) void {
        self.content.free();
        self.content = String.new();
    }
}

impl ReadableConfig for IniDocument {
    pub fn parse_string(self: IniDocument, content: str) void {
        self.content.free();
        self.content = String.from(content);
    }
}

impl WriteableConfig for IniDocument {
    pub fn stringify(self: IniDocument) String {
        ret String.from(self.content.as_str());
    }
}

@test
fn parses_sections_values_and_comments() void {
    var config = IniDocument.new();
    config.parse_string(`# global comment
app_version = 1.0.0

[database]
host = localhost
port = 5432

[server]
token = left=right
empty =
`);

    const host = config.get("database", "host");
    if host.as_str() != "localhost" { panic("database.host was parsed incorrectly"); }

    const token = config.get("server", "token");
    if token.as_str() != "left=right" { panic("values must preserve embedded equals signs"); }

    if !config.has_section("database") { panic("database section was not found"); }
    if !config.contains("server", "empty") { panic("empty values must remain present"); }
    if config.contains("server", "missing") { panic("missing key was reported as present"); }
    config.free();
}

@test
fn reparsing_replaces_the_document() void {
    var config = IniDocument.new();
    config.parse_string("[old]\nvalue = stale\n");
    config.parse_string("[new]\nvalue = fresh\n");

    if config.has_section("old") { panic("reparse retained the previous document"); }
    const value = config.get("new", "value");
    if value.as_str() != "fresh" { panic("reparse did not install the new document"); }

    const serialized = config.stringify();
    if serialized.as_str() != "[new]\nvalue = fresh\n" {
        panic("stringify did not preserve the reparsed source");
    }
    config.free();
    config.free();
    const after_free = config.stringify();
    if !after_free.is_empty() { panic("free must leave an empty reusable document"); }
}
