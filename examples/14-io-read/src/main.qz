import std.io;

fn main() i32 {
    // Test 1: readln — read a line from stdin
    io.println("Enter your name:");
    var name: String = io.readln().unwrap();
    io.println("Hello, {}!", name.as_str());

    // Test 2: readkey — read a single character
    io.println("Press any key:");
    var key: String = io.readkey().unwrap();
    io.println("You pressed: {}", key.as_str());

    // Test 3: read_until — read until a custom delimiter
    // UTF-8 delimiters are strings, so callers never need numeric byte values.
    io.println("Type something (end with '.'):");
    var text: String = io.read(".").unwrap();
    io.println("You typed: {}", text.as_str());

    io.println("Done!");
    ret 0;
}
