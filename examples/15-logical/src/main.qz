import std.io;

fn main() i32 {
    var t: bool = true;
    var f: bool = false;
    var x: i32 = 5;
    var y: i32 = 10;
    var z: i32 = 5;

    io.println("=== Logical NOT (!) ===");
    io.print("!true  = "); if (!t) { io.println("true (WRONG)"); } else { io.println("false (OK)"); }
    io.print("!false = "); if (!f) { io.println("true (OK)");   } else { io.println("false (WRONG)"); }
    io.print("!!true = "); if (!!t) { io.println("true (OK)");  } else { io.println("false (WRONG)"); }

    io.println("");
    io.println("=== Logical AND (&&) ===");
    io.print("true  && true  = "); if (t && t) { io.println("true (OK)");    } else { io.println("false (WRONG)"); }
    io.print("true  && false = "); if (t && f) { io.println("true (WRONG)"); } else { io.println("false (OK)"); }
    io.print("false && true  = "); if (f && t) { io.println("true (WRONG)"); } else { io.println("false (OK)"); }
    io.print("false && false = "); if (f && f) { io.println("true (WRONG)"); } else { io.println("false (OK)"); }

    io.println("");
    io.println("=== Logical OR (||) ===");
    io.print("true  || true  = "); if (t || t) { io.println("true (OK)");    } else { io.println("false (WRONG)"); }
    io.print("true  || false = "); if (t || f) { io.println("true (OK)");    } else { io.println("false (WRONG)"); }
    io.print("false || true  = "); if (f || t) { io.println("true (OK)");    } else { io.println("false (WRONG)"); }
    io.print("false || false = "); if (f || f) { io.println("true (WRONG)"); } else { io.println("false (OK)"); }

    io.println("");
    io.println("=== Equality (==) and Inequality (!=) ===");
    io.print("x == z (5 == 5)  = "); if (x == z)  { io.println("true (OK)");    } else { io.println("false (WRONG)"); }
    io.print("x == y (5 == 10) = "); if (x == y)  { io.println("true (WRONG)"); } else { io.println("false (OK)"); }
    io.print("x != y (5 != 10) = "); if (x != y)  { io.println("true (OK)");    } else { io.println("false (WRONG)"); }
    io.print("x != z (5 != 5)  = "); if (x != z)  { io.println("true (WRONG)"); } else { io.println("false (OK)"); }
    io.print("t != f           = "); if (t != f)  { io.println("true (OK)");    } else { io.println("false (WRONG)"); }
    io.print("t != t           = "); if (t != t)  { io.println("true (WRONG)"); } else { io.println("false (OK)"); }

    io.println("");
    io.println("=== Combined Expressions ===");
    io.print("x > 0 && y > 0                   = ");
    if (x > 0 && y > 0)                   { io.println("true (OK)");    } else { io.println("false (WRONG)"); }

    io.print("x > 0 && !(x == y)               = ");
    if (x > 0 && !(x == y))               { io.println("true (OK)");    } else { io.println("false (WRONG)"); }

    io.print("x == z || x == y                 = ");
    if (x == z || x == y)                 { io.println("true (OK)");    } else { io.println("false (WRONG)"); }

    io.print("x != y && y != z                 = ");
    if (x != y && y != z)                 { io.println("true (OK)");    } else { io.println("false (WRONG)"); }

    io.print("x > 0 && y > 0 && x != y        = ");
    if (x > 0 && y > 0 && x != y)        { io.println("true (OK)");    } else { io.println("false (WRONG)"); }

    io.print("!(x == y) && !(y == z)           = ");
    if (!(x == y) && !(y == z))           { io.println("true (OK)");    } else { io.println("false (WRONG)"); }

    io.print("(x == z && t) || (x == y && f)   = ");
    if ((x == z && t) || (x == y && f))   { io.println("true (OK)");    } else { io.println("false (WRONG)"); }

    io.print("(x != z || t) && !(f && t)       = ");
    if ((x != z || t) && !(f && t))       { io.println("true (OK)");    } else { io.println("false (WRONG)"); }

    ret 0;
}
