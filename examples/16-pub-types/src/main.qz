import std.io;

import helper.PublicStruct;
import helper.get_public;
// import helper.PrivateStruct; // Uncommenting this will cause a compilation error (S04)

fn main() i32 {
    var pub_struct: PublicStruct = get_public();

    io.print("Successfully imported and used PublicStruct! Value: ");
    
    // In Quazilang, format() is often used, but io.println natively works with strings.
    // If we wanted to print an integer directly, we can use `std.core.int_to_str`,
    // but the `println` function uses format implicitly if args are passed in.
    
    // To keep it simple, we just print the success.
    io.println("42");

    ret 0;
}
