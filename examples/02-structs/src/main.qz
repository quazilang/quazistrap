import std.io.println;

struct Vec2 {
    x: f64,
    y: f64,
}

impl Vec2 {
    fn new(x: f64, y: f64) Vec2 {
        ret Vec2 { x: x, y: y };
    }

    fn add(self: Vec2, other: Vec2) Vec2 {
        ret Vec2 { x: self.x + other.x, y: self.y + other.y };
    }

    fn scale(self: Vec2, factor: f64) Vec2 {
        ret Vec2 { x: self.x * factor, y: self.y * factor };
    }

    fn dot(self: Vec2, other: Vec2) f64 {
        ret self.x * other.x + self.y * other.y;
    }
}

struct Color {
    r: u8,
    g: u8,
    b: u8,
}

impl Color {
    fn new(r: u8, g: u8, b: u8) Color {
        ret Color { r: r, g: g, b: b };
    }

    fn blend(self: Color, other: Color) Color {
        ret Color {
            r: (self.r + other.r) / 2,
            g: (self.g + other.g) / 2,
            b: (self.b + other.b) / 2,
        };
    }
	
	fn invert(self: Color) Color {
		ret Color {
			r: 255-self.r,
			g: 255-self.g,
			b: 255-self.b,
		};
	}
}

fn main() i32 {
    var a = Vec2.new(3.0, 4.0);
    var b = Vec2.new(1.0, 2.0);

    var sum = a.add(b);
    println("a + b = ({}, {})", sum.x, sum.y);

    var scaled = a.scale(2.0);
    println("a * 2 = ({}, {})", scaled.x, scaled.y);

    println("a · b = {}", a.dot(b));

    var red   = Color.new(255, 0, 0);
    var blue  = Color.new(0, 0, 255);
    var mixed = red.blend(blue);
	var white = Color.new(255,255,255);
	var black = white.invert();
    println("red + blue = rgb({}, {}, {})", mixed.r, mixed.g, mixed.b);
	println("white = rgb({},{},{}); inverted = rgb({},{},{}) (black)", white.r, white.g, white.b, black.r, black.g, black.b);

    ret 0;
}
