import std.core;
import std.fs;
import std.io;
import std.os;
import std.ffi.CString;

// Optional NetBSD process discovery uses libc + the base-system ps utility.
// No guesses from TERM=xterm: it only names a terminal capability profile.
// If ps/popen is unavailable, retain the existing environment-based fallback.
@cfg(target_os = "netbsd")
@api("popen") unsafe fn nb_popen(command: *u8, mode: *u8) *u8;
@cfg(target_os = "netbsd")
@api("fgets") unsafe fn nb_fgets(buffer: *u8, capacity: i32, file: *u8) *u8;
@cfg(target_os = "netbsd")
@api("pclose") unsafe fn nb_pclose(file: *u8) i32;

@cfg(target_os = "netbsd")
fn netbsd_ps(command: str) String {
    const encoded = CString.try_from_str(command);
    if (encoded.is_err()) { ret String.new(); }
    const cmd = encoded.unwrap();
    var stream: *u8 = 0;
    var buffer: *u8 = 0;
    unsafe {
        stream = nb_popen(cmd.as_ptr(), core.str_as_ptr("r"));
        if (stream == 0) { ret String.new(); }
        buffer = core.malloc(512);
        if (buffer == 0) {
            nb_pclose(stream);
            ret String.new();
        }
    }
    var output = String.new();
    var loops: usize = 0;
    for (loops < 64) {
        var read: *u8 = 0;
        unsafe { read = nb_fgets(buffer, 512, stream); }
        if (read == 0) { break; }
        var chunk = String.new();
        unsafe { chunk = String.from(core.str_from_ptr(buffer)); }
        output = output.push_str(chunk.as_str());
        loops++;
    }
    unsafe {
        core.free(buffer);
        nb_pclose(stream);
    }
    ret output;
}

// Exact whole-line matching avoids e.g. mistaking 'xterm' for a WM.
@cfg(target_os = "netbsd")
fn netbsd_has_process(output: str, program: str) bool {
    const len = core.strlen(output);
    var start: usize = 0;
    var pos: usize = 0;
    for (pos <= len) {
        if (pos == len || core.str_byte_at(output, pos) == 10) {
            if (pos > start) {
                const raw = output[start as isize:pos as isize];
                const line = raw.trim();
                if (line.as_str() == program) { ret true; }
            }
            start = pos + 1;
        }
        pos++;
    }
    ret false;
}

@cfg(target_os = "netbsd")
fn netbsd_window_manager() String {
    const list = netbsd_ps("ps -ax -o ucomm= 2>/dev/null");
    if (netbsd_has_process(list.as_str(), "vxwm")) { ret String.from("vxwm"); }
    if (netbsd_has_process(list.as_str(), "dwm")) { ret String.from("dwm"); }
    if (netbsd_has_process(list.as_str(), "i3")) { ret String.from("i3"); }
    if (netbsd_has_process(list.as_str(), "bspwm")) { ret String.from("bspwm"); }
    if (netbsd_has_process(list.as_str(), "openbox")) { ret String.from("openbox"); }
    if (netbsd_has_process(list.as_str(), "xfwm4")) { ret String.from("xfwm4"); }
    if (netbsd_has_process(list.as_str(), "awesome")) { ret String.from("awesome"); }
    if (netbsd_has_process(list.as_str(), "xmonad")) { ret String.from("xmonad"); }
    if (netbsd_has_process(list.as_str(), "fluxbox")) { ret String.from("fluxbox"); }
    if (netbsd_has_process(list.as_str(), "icewm")) { ret String.from("icewm"); }
    if (netbsd_has_process(list.as_str(), "cwm")) { ret String.from("cwm"); }
    if (netbsd_has_process(list.as_str(), "ctwm")) { ret String.from("ctwm"); }
    if (netbsd_has_process(list.as_str(), "sway")) { ret String.from("sway"); }
    if (netbsd_has_process(list.as_str(), "Hyprland")) { ret String.from("Hyprland"); }
    if (netbsd_has_process(list.as_str(), "kwin_x11")) { ret String.from("KWin"); }
    if (netbsd_has_process(list.as_str(), "mutter")) { ret String.from("Mutter"); }
    ret String.new();
}

// Discover the terminal by walking the parent PID chain, rather than reading
// the generic TERM=xterm terminfo name. Uses only numeric PIDs from the kernel.
@cfg(target_os = "netbsd")
fn netbsd_ps_pid_field(pid: i32, field: str) String {
    if (pid <= 1) { ret String.new(); }
    const pid_text = pid.to_string();
    var command = String.from("ps -p ");
    command = command.push_str(pid_text.as_str());
    command = command.push_str(" -o ");
    command = command.push_str(field);
    command = command.push_str("= 2>/dev/null");
    const raw = netbsd_ps(command.as_str());
    const trimmed: String = raw.trim();
    ret String.from(trimmed.as_str());
}

@cfg(target_os = "netbsd")
fn netbsd_terminal_process() String {
    var pid: i32 = os.getppid();
    var hops: usize = 0;
    for (pid > 1 && hops < 10) {
        const proc_name = netbsd_ps_pid_field(pid, "comm");
        const executable = basename_of(proc_name);
        if (executable.as_str() == "alacritty") { ret String.from("alacritty"); }
        if (executable.as_str() == "kitty") { ret String.from("kitty"); }
        if (executable.as_str() == "wezterm-gui") { ret String.from("WezTerm"); }
        if (executable.as_str() == "foot") { ret String.from("foot"); }
        if (executable.as_str() == "xterm") { ret String.from("xterm"); }
        if (executable.as_str() == "urxvt") { ret String.from("urxvt"); }
        if (executable.as_str() == "konsole") { ret String.from("Konsole"); }
        if (executable.as_str() == "gnome-terminal-") { ret String.from("GNOME Terminal"); }
        const raw_parent = netbsd_ps_pid_field(pid, "ppid");
        const parsed = raw_parent.parse[i32]();
        if (parsed.is_err()) { break; }
        const next = parsed.unwrap();
        if (next <= 1 || next == pid) { break; }
        pid = next;
        hops++;
    }
    ret String.new();
}

// Path formatting only; OS discovery is delegated to std.os.
@ignore(dead_code)
fn basename_of(path: String) String {
    const text: str = path.as_str();
    const length: usize = path.len();
    var start: usize = 0;
    var i: usize = 0;
    for (i < length) {
        const byte: u8 = core.str_byte_at(text, i);
        if (byte == 47 || byte == 92) { start = i + 1; }
        i++;
    }
    // Copy the basename into separately owned storage; no escaping view.
    const byte_count: usize = length - start;
    var copy: *u8 = 0;
    unsafe { copy = core.malloc(byte_count + 1); }
    if (copy == 0) { ret String.new(); }
    unsafe {
        core.memcpy(copy, core.str_as_ptr(text) + start, byte_count);
        *(copy + byte_count) = 0;
    }
    var result: String = String.new();
    unsafe { result = String.from_raw(copy, byte_count, byte_count + 1); }
    ret result;
}

// Formatting produces a complete String owner and transfers it to the caller.
fn owned_u64(value: u64) String {
    ret value.to_string();
}

// The platform-independent surface is std.os. Linux retains its existing
// /proc release and CPU-model detail; NetBSD uses the portable OS/CPU API.
fn get_os() String {
    @cfg(target_os = "windows") { ret os.version(); }
    @cfg(target_os = "netbsd") { ret os.version(); }
    @cfg(target_os = "linux") {
        const read: Result[String, fs.FsError] = fs.read_to_string("/proc/sys/kernel/osrelease");
        if (read.is_ok()) {
            const raw_release: String = read.unwrap();
            const release: String = raw_release.trim();
            var result: String = String.from(os.name());
            result = result.push_str(" ");
            result = result.push_str(release.as_str());
            ret result;
        }
        ret String.from(os.name());
    }
}

fn get_cpu() String {
    // The same CPU brand source is used on Linux, NetBSD and Windows.
    ret os.cpu_name();
}

fn get_memory() String {
    const total: u64 = os.memory_total();
    const available: u64 = os.memory_available();
    var used: u64 = 0;
    if (available <= total) { used = total - available; }
    const mib: u64 = 1048576;
    const used_text: String = owned_u64(used / mib);
    const total_text: String = owned_u64(total / mib);
    var result: String = String.from(used_text.as_str());
    result = result.push_str(" MiB / ");
    result = result.push_str(total_text.as_str());
    result = result.push_str(" MiB");
    ret result;
}

fn get_shell() String {
    var shell: String = String.new();
    @cfg(target_os = "windows") { shell = os.shell(); }
    @cfg(target_os = "linux") { shell = basename_of(os.shell()); }
    @cfg(target_os = "netbsd") { shell = basename_of(os.shell()); }
    ret shell;
}

// Shared XDG/window-manager detection for Unix hosts. The WM name is not
// guessed when a minimal X11 session provides no discovery metadata.
@ignore(dead_code)
fn detect_unix_desktop() String {
    // Prefer explicit desktop/session declarations on both Linux and NetBSD.
    const desktop: String = os.env("XDG_CURRENT_DESKTOP", "");
    const session: String = os.env("XDG_SESSION_TYPE", "");
    const named_session: String = os.env("XDG_SESSION_DESKTOP", "");
    const desktop_session: String = os.env("DESKTOP_SESSION", "");
    const gdm_session: String = os.env("GDMSESSION", "");
    const wm: String = os.env("WINDOWMANAGER", "");
    const user_wm: String = os.env("WM", "");

    var display: String = String.new();
    if (!desktop.is_empty()) {
        display = String.from(desktop.as_str());
    } else if (!named_session.is_empty()) {
        display = String.from(named_session.as_str());
    } else if (!desktop_session.is_empty()) {
        display = String.from(desktop_session.as_str());
    } else if (!gdm_session.is_empty()) {
        display = String.from(gdm_session.as_str());
    } else if (!wm.is_empty()) {
        display = basename_of(wm);
    } else if (!user_wm.is_empty()) {
        display = basename_of(user_wm);
    }

    if (!display.is_empty()) {
        if (!session.is_empty()) {
            display = display.push_str(" (");
            display = display.push_str(session.as_str());
            display = display.push_str(")");
        }
        ret display;
    }
    @cfg(target_os = "netbsd") {
        const process_wm = netbsd_window_manager();
        if (!process_wm.is_empty()) {
            var detected = String.from(process_wm.as_str());
            detected = detected.push_str(" (X11)");
            ret detected;
        }
    }
    if (!os.env("WAYLAND_DISPLAY", "").is_empty()) {
        ret String.from("Wayland (compositor not detected)");
    }
    if (!os.env("DISPLAY", "").is_empty()) {
        ret String.from("X11 (WM not detected)");
    }
    ret String.from("Console (no graphical session)");
}

fn get_desktop() String {
    var result: String = String.new();
    @cfg(target_os = "windows") { result = String.from("Explorer"); }
    @cfg(target_os = "linux") { result = detect_unix_desktop(); }
    @cfg(target_os = "netbsd") { result = detect_unix_desktop(); }
    ret result;
}

@ignore(dead_code)
fn normalized_terminal(value: String) String {
    if (value.as_str() == "kgx") { ret String.from("GNOME Console"); }
    if (value.as_str() == "iTerm.app") { ret String.from("iTerm2"); }
    if (value.as_str() == "Terminal.app") { ret String.from("Apple Terminal"); }
    if (value.as_str() == "Hyper") { ret String.from("HyperTerm"); }
    if (value.as_str() == "rxvt-unicode-256color") { ret String.from("urxvt"); }
    if (value.as_str() == "xterm-256color") { ret String.from("xterm"); }
    if (value.as_str() == "xterm-kitty") { ret String.from("kitty"); }
    if (value.as_str() == "linux") { ret String.from("tty"); }
    ret value;
}

@ignore(dead_code)
fn detect_unix_terminal() String {
    const program: String = os.env("TERM_PROGRAM", "");
    if (!program.is_empty()) { ret normalized_terminal(program); }
    @cfg(target_os = "netbsd") {
        const detected = netbsd_terminal_process();
        if (!detected.is_empty()) { ret detected; }
    }
    ret normalized_terminal(os.env("TERM", "unknown"));
}

fn get_terminal() String {
    var terminal: String = String.new();
    @cfg(target_os = "windows") { terminal = os.terminal(); }
    @cfg(target_os = "linux") { terminal = detect_unix_terminal(); }
    @cfg(target_os = "netbsd") { terminal = detect_unix_terminal(); }
    ret terminal;
}

fn append_count(result: String, tag: str, count: usize) String {
    var next: String = result;
    if (!next.is_empty()) { next = next.push_str(", "); }
    const amount: String = owned_u64(count as u64);
    next = next.push_str(tag);
    next = next.push_str(" (");
    next = next.push_str(amount.as_str());
    next = next.push_str(")");
    ret next;
}

fn append_directory_count(result: String, path: str, tag: str) String {
    const counted: Result[usize, fs.FsError] = fs.count_entries(path);
    if (counted.is_err()) { ret result; }
    ret append_count(result, tag, counted.unwrap());
}

@cfg(target_os = "linux")
fn starts_at_bounded(
    text: str, offset: usize, needle: str, text_len: usize, needle_len: usize
) bool {
    if (offset + needle_len > text_len) { ret false; }
    var i: usize = 0;
    for (i < needle_len) {
        if (core.str_byte_at(text, offset + i) != core.str_byte_at(needle, i)) {
            ret false;
        }
        i++;
    }
    ret true;
}

@cfg(target_os = "linux")
fn count_occurrences(text: str, needle: str) usize {
    const length: usize = core.strlen(text);
    const needle_length: usize = core.strlen(needle);
    if (needle_length == 0 || needle_length > length) { ret 0; }
    var count: usize = 0;
    var offset: usize = 0;
    for (offset + needle_length <= length) {
        if (starts_at_bounded(text, offset, needle, length, needle_length)) {
            count++;
            offset = offset + needle_length;
            continue;
        }
        offset++;
    }
    ret count;
}

fn get_packages() String {
    var result: String = String.new();
    @cfg(target_os = "linux") {
        const dpkg: Result[String, fs.FsError] = fs.read_to_string("/var/lib/dpkg/status");
        if (dpkg.is_ok()) {
            const status: String = dpkg.unwrap();
            result = append_count(
                result, "apt", count_occurrences(status.as_str(), "Status: install ok installed")
            );
        }
        const apk: Result[String, fs.FsError] = fs.read_to_string("/lib/apk/db/installed");
        if (apk.is_ok()) {
            const database: String = apk.unwrap();
            result = append_count(
                result, "apk", count_occurrences(database.as_str(), "P:")
            );
        }
        result = append_directory_count(result, "/var/lib/pacman/local", "pacman");
        result = append_directory_count(result, "/var/db/xbps", "xbps");
        result = append_directory_count(result, "/nix/store", "nix");
        result = append_directory_count(result, "/var/lib/flatpak/app", "flatpak");
    }
    @cfg(target_os = "netbsd") {
        // Since 2020 the NetBSD pkgsrc default database is /usr/pkg/pkgdb.
        // Respect overrides, then try modern, legacy and unprivileged layouts.
        const override_db: String = os.env("PKG_DBDIR", "");
        if (!override_db.is_empty()) {
            result = append_directory_count(result, override_db.as_str(), "pkgsrc");
        }
        if (result.is_empty()) {
            result = append_directory_count(result, "/usr/pkg/pkgdb", "pkgsrc");
        }
        if (result.is_empty()) {
            result = append_directory_count(result, "/var/db/pkg", "pkgsrc");
        }
        if (result.is_empty()) {
            const home: String = os.env("HOME", "");
            if (!home.is_empty()) {
                var user_db: String = String.from(home.as_str());
                user_db = user_db.push_str("/pkg/pkgdb");
                result = append_directory_count(result, user_db.as_str(), "pkgsrc");
            }
        }
        if (result.is_empty()) {
            result = append_directory_count(result, "/nix/store", "nix");
        }
    }
    @cfg(target_os = "windows") {
        const chocolatey: String = os.env("ChocolateyInstall", "");
        const scoop: String = os.env("SCOOP", "");
        const local: String = os.env("LOCALAPPDATA", "");
        if (!chocolatey.is_empty()) {
            var choco_path: String = String.from(chocolatey.as_str());
            choco_path = choco_path.push_str("\\lib");
            result = append_directory_count(result, choco_path.as_str(), "choco");
        } else {
            result = append_directory_count(
                result, "C:\\ProgramData\\chocolatey\\lib", "choco"
            );
        }
        if (!scoop.is_empty()) {
            var scoop_path: String = String.from(scoop.as_str());
            scoop_path = scoop_path.push_str("\\apps");
            result = append_directory_count(result, scoop_path.as_str(), "scoop");
        }
        if (!local.is_empty()) {
            var winget: String = String.from(local.as_str());
            winget = winget.push_str("\\Microsoft\\WinGet\\Packages");
            const portable_count: Result[usize, fs.FsError] = fs.count_entries(winget.as_str());
            if (portable_count.is_ok()) {
                result = append_count(result, "winget", portable_count.unwrap());
            } else {
                var packaged: String = String.from(local.as_str());
                packaged = packaged.push_str(
                    "\\Packages\\Microsoft.DesktopAppInstaller_8wekyb3d8bbwe\\LocalState\\packages"
                );
                result = append_directory_count(result, packaged.as_str(), "winget");
            }
            // Not every Windows installation has a third-party package
            // manager. Fall back to the per-user AppX/MSIX package store so
            // the row still reports useful, countable Windows packages.
            if (result.is_empty()) {
                var appx: String = String.from(local.as_str());
                appx = appx.push_str("\\Packages");
                result = append_directory_count(result, appx.as_str(), "appx");
            }
        }
        if (result.is_empty()) {
            result = append_directory_count(
                result, "C:\\ProgramData\\Package Cache", "package-cache"
            );
        }
        if (result.is_empty()) {
            result = append_directory_count(
                result, "C:\\Program Files", "programs"
            );
        }
    }
    if (result.is_empty()) { ret String.from("not detected"); }
    ret result;
}

fn row(color: str, label: str, value: str) void {
    io.print("\e[{}m  {}\e[0m  {}\n", color, label, value);
}

fn main(args: Array[str]) void {
    var ascii: bool = false;
    var arg_index: usize = 1;
    for (arg_index < args.len()) {
        const arg: str = args[arg_index];
        if (arg == "-a" || arg == "--ascii") {
            ascii = true;
        }
        arg_index++;
    }

    const raw_hostname: String = os.hostname();
    const hostname: String = raw_hostname.to_lowercase();
    const system: String = get_os();
    const cpu: String = get_cpu();
    const memory: String = get_memory();
    const shell: String = get_shell();
    const desktop: String = get_desktop();
    const terminal: String = get_terminal();
    const packages: String = get_packages();

    io.println("");
    if (ascii) {
        io.println("  \e[1;96m+--------------------+");
        io.println("  |   \e[1;97m~ quazifetch ~\e[1;96m   |");
        io.println("  +--------------------+\e[0m");
    } else {
        io.println("  \e[1;96m╭────────────────────╮");
        io.println("  │   \e[1;97m~ quazifetch ~\e[1;96m   │");
        io.println("  ╰────────────────────╯\e[0m");
    }
    io.println("");
    row("1;33", "host  ", hostname.as_str());
    row("1;32", "kernel", system.as_str());
    row("1;35", "pkgs  ", packages.as_str());
    row("1;34", "shell ", shell.as_str());
    row("1;31", "de/wm ", desktop.as_str());
    row("1;36", "term  ", terminal.as_str());
    io.println("");
    row("1;32", "cpu   ", cpu.as_str());
    row("1;31", "ram   ", memory.as_str());
    io.println("");
}
