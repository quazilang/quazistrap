import std.io.println;

@repr(C) struct Point {
    x: f64,
    y: f64,
}

@repr(C) struct Sample {
    value: f32,
    tag: i32,
}

@repr(C) struct Triple {
    a: i64,
    b: i64,
    c: i64,
}

@repr(C)
type BinaryCallback = fn(i64, i64) i64;

@api("c_roundtrip_point")
unsafe fn c_roundtrip_point(point: Point, bias: f32) Point;

@api("c_roundtrip_sample")
unsafe fn c_roundtrip_sample(sample: Sample) Sample;

@api("c_roundtrip_triple")
unsafe fn c_roundtrip_triple(triple: Triple) Triple;

@api("c_sum8")
unsafe fn c_sum8(
    a: i64, b: i64, c: i64, d: i64,
    e: i64, f: i64, g: i64, h: i64
) i64;

@api("c_call_quazi_sum8")
unsafe fn c_call_quazi_sum8() i64;

@api("c_apply_callback")
unsafe fn c_apply_callback(callback: BinaryCallback, a: i64, b: i64) i64;

@api("c_get_add_callback")
unsafe fn c_get_add_callback() BinaryCallback;

@api("c_global_counter")
var c_counter: i32;

@api("c_global_ratio")
var c_ratio: f32;

@export("quazi_scale_point")
pub fn scale_point(point: Point, factor: f64) Point {
    ret Point {
        x: point.x * factor,
        y: point.y * factor,
    };
}

@export("quazi_adjust_sample")
pub fn adjust_sample(sample: Sample) Sample {
    ret Sample {
        value: sample.value + 0.5,
        tag: sample.tag + 10,
    };
}

@export("quazi_bump_triple")
pub fn bump_triple(triple: Triple) Triple {
    ret Triple {
        a: triple.a + 10,
        b: triple.b + 10,
        c: triple.c + 10,
    };
}

@export("quazi_sum8")
pub fn sum8(
    a: i64, b: i64, c: i64, d: i64,
    e: i64, f: i64, g: i64, h: i64
) i64 {
    ret a + b + c + d + e + f + g + h;
}

@export("quazi_multiply")
pub fn multiply(a: i64, b: i64) i64 {
    ret a * b;
}

fn main() i32 {
    println("C interoperability showcase");

    unsafe {
        var point = c_roundtrip_point(Point { x: 1.0, y: 2.0 }, 0.5 as f32);
        var sample = c_roundtrip_sample(Sample { value: 1.0, tag: 1 });
        var triple = c_roundtrip_triple(Triple { a: 1, b: 2, c: 3 });
        println("point returned through C: ({}, {})", point.x, point.y);
        println("mixed aggregate: value={}, tag={}", sample.value, sample.tag);
        println("large aggregate: ({}, {}, {})", triple.a, triple.b, triple.c);
        println("eight C arguments sum to {}", c_sum8(1, 2, 3, 4, 5, 6, 7, 8));
        println("C calling exported Quazi sum: {}", c_call_quazi_sum8());
        println("Quazi callback called by C: {}", c_apply_callback(multiply, 6, 7));
        var add = c_get_add_callback();
        println("C callback called by Quazi: {}", add(20, 22));
        c_counter += 2;
        c_ratio = 2.5 as f32;
        println("foreign globals: counter={}, ratio={}", c_counter, c_ratio);
    }
    ret 0;
}
