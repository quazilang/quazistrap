import std.io.println;

fn apply(f: fn(i32) i32, x: i32) i32 {
    ret f(x);
}

fn apply_twice(f: fn(i32) i32, x: i32) i32 {
    ret f(f(x));
}

fn make_adder(n: i32) fn(i32) i32 {
    ret |x| x + n;
}

fn make_multiplier(n: i32) fn(i32) i32 {
    ret |x| x * n;
}

fn main() i32 {
    var double = |x| x * 2;
    var square = |x| x * x;
    var negate = |x| x * -1;

    println("double(7)       = {}", apply(double, 7));
    println("square(7)       = {}", apply(square, 7));
    println("double twice(3) = {}", apply_twice(double, 3));
    println("square twice(2) = {}", apply_twice(square, 2));

    var add5  = make_adder(5);
    var times3 = make_multiplier(3);

    println("add5(10)   = {}", add5(10));
    println("times3(10) = {}", times3(10));
    println("add5(times3(4)) = {}", add5(times3(4)));

    var ops: [fn(i32) i32; 3] = [double, square, negate];
    var val: i32 = 5;
    for op : ops {
        println("op({}) = {}", val, op(val));
    }

    ret 0;
}
