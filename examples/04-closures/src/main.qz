import std.io.println;

fn main() i32 {
    var double = |x| x * 2;
    var square = |x| x * x;
    var negate = |x| x * -1;

    println("double(7)       = {}", double(7));
    println("square(7)       = {}", square(7));

    var ops: [fn(i32) i32; 3] = [double, square, negate];
    var val: i32 = 5;
    for op : ops {
        println("op({}) = {}", val, op(val));
    }

    ret 0;
}
