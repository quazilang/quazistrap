import std.io.println;

fn main() i32 {
    var double: fn(i32) i32 = |x| x * 2;
    var square: fn(i32) i32 = |x| x * x;
    var negate: fn(i32) i32 = |x| x * -1;

    println("double(7)       = {}", double(7));
    println("square(7)       = {}", square(7));

    var val: i32 = 5;
    println("double({}) = {}", val, double(val));
    println("square({}) = {}", val, square(val));
    println("negate({}) = {}", val, negate(val));

    ret 0;
}
