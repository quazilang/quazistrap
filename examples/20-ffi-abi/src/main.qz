import std.io.println;

@repr(C) struct Point {
    x: f64,
    y: f64,
}

@repr(C) struct Sample {
    value: f32,
    tag: i32,
}

@repr(C) struct Triple {
    a: i64,
    b: i64,
    c: i64,
}

@repr(C)
type BinaryCallback = fn(i64, i64) i64;

@api("c_roundtrip_point")
unsafe fn c_roundtrip_point(point: Point, bias: f32) Point;

@api("c_roundtrip_sample")
unsafe fn c_roundtrip_sample(sample: Sample) Sample;

@api("c_roundtrip_triple")
unsafe fn c_roundtrip_triple(triple: Triple) Triple;

@api("c_sum8")
unsafe fn c_sum8(
    a: i64, b: i64, c: i64, d: i64,
    e: i64, f: i64, g: i64, h: i64
) i64;

@api("c_call_quazi_sum8")
unsafe fn c_call_quazi_sum8() i64;

@api("c_apply_callback")
unsafe fn c_apply_callback(callback: BinaryCallback, a: i64, b: i64) i64;

@api("c_get_add_callback")
unsafe fn c_get_add_callback() BinaryCallback;

@api("c_global_counter")
var c_counter: i32;

@api("c_global_ratio")
var c_ratio: f32;

@export("quazi_scale_point")
pub fn scale_point(point: Point, factor: f64) Point {
    ret Point {
        x: point.x * factor,
        y: point.y * factor,
    };
}

@export("quazi_adjust_sample")
pub fn adjust_sample(sample: Sample) Sample {
    ret Sample {
        value: sample.value + 0.5,
        tag: sample.tag + 10,
    };
}

@export("quazi_bump_triple")
pub fn bump_triple(triple: Triple) Triple {
    ret Triple {
        a: triple.a + 10,
        b: triple.b + 10,
        c: triple.c + 10,
    };
}

@export("quazi_sum8")
pub fn sum8(
    a: i64, b: i64, c: i64, d: i64,
    e: i64, f: i64, g: i64, h: i64
) i64 {
    ret a + b + c + d + e + f + g + h;
}

@export("quazi_multiply")
pub fn multiply(a: i64, b: i64) i64 {
    ret a * b;
}

fn main() i32 {
    println("Quazi C ABI Phase 2 self-test");
    println("Running 9 C interoperability checks on this platform...");

    unsafe {
        var point = c_roundtrip_point(Point { x: 1.0, y: 2.0 }, 0.5 as f32);
        if (point.x != 3.0 || point.y != 4.0) {
            println("[1/9] FAIL: Point aggregate or f32 argument crossed the C boundary incorrectly.");
            ret 1;
        }
        println("[1/9] PASS: Point aggregate and f32 argument round trip");

        var sample = c_roundtrip_sample(Sample { value: 1.0, tag: 1 });
        if (sample.value != 1.75 || sample.tag != 12) {
            println("[2/9] FAIL: mixed float/integer Sample aggregate returned an unexpected value.");
            ret 2;
        }
        println("[2/9] PASS: mixed float/integer Sample aggregate round trip");

        var triple = c_roundtrip_triple(Triple { a: 1, b: 2, c: 3 });
        if (triple.a != 12 || triple.b != 13 || triple.c != 14) {
            println("[3/9] FAIL: large Triple aggregate returned an unexpected value.");
            ret 3;
        }
        println("[3/9] PASS: large memory-class Triple aggregate round trip");

        if (c_sum8(1, 2, 3, 4, 5, 6, 7, 8) != 36) {
            println("[4/9] FAIL: Quazi-to-C call with stack arguments returned the wrong sum.");
            ret 4;
        }
        println("[4/9] PASS: Quazi calls C with register and stack arguments");
        if (c_call_quazi_sum8() != 36) {
            println("[5/9] FAIL: C-to-Quazi exported call returned the wrong sum.");
            ret 5;
        }
        println("[5/9] PASS: C calls an exported Quazi function");
        if (c_apply_callback(multiply, 6, 7) != 42) {
            println("[6/9] FAIL: C could not invoke an exported Quazi callback correctly.");
            ret 6;
        }
        println("[6/9] PASS: exported Quazi function works as a C callback");
        var add = c_get_add_callback();
        if (add(20, 22) != 42) {
            println("[7/9] FAIL: Quazi could not invoke a callback returned by C correctly.");
            ret 7;
        }
        println("[7/9] PASS: Quazi invokes a function pointer returned by C");
        c_counter += 2;
        if (c_counter != 42) {
            println("[8/9] FAIL: mutable integer foreign global did not contain 42.");
            ret 8;
        }
        println("[8/9] PASS: mutable integer foreign global read and write");
        c_ratio = 2.5 as f32;
        if (c_ratio != 2.5) {
            println("[9/9] FAIL: mutable f32 foreign global did not contain 2.5.");
            ret 9;
        }
        println("[9/9] PASS: mutable f32 foreign global read and write");
    }

    println("All C ABI Phase 2 checks passed.");
    println("Callbacks, exports, aggregates, stack arguments, and foreign globals are working.");
    ret 0;
}
