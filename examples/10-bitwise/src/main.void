import std.io;

fn main() i32 {
    var a: u32 = 12;
    var b: u32 = 10;

    io.println("Bitwise operations:");

    io.print("a & b  = ");
    if ((a & b) == 8) {
        io.println("8 (OK)");
    } else {
        io.println("WRONG");
    }

    io.print("a | b  = ");
    if ((a | b) == 14) {
        io.println("14 (OK)");
    } else {
        io.println("WRONG");
    }

    io.print("a ^ b  = ");
    if ((a ^ b) == 6) {
        io.println("6 (OK)");
    } else {
        io.println("WRONG");
    }

    io.print("a << 2 = ");
    if ((a << 2) == 48) {
        io.println("48 (OK)");
    } else {
        io.println("WRONG");
    }

    io.print("a >> 1 = ");
    if ((a >> 1) == 6) {
        io.println("6 (OK)");
    } else {
        io.println("WRONG");
    }

    ret 0;
}
