// examples/17-constfold — cross-basic-block constant propagation demo.
//
// The qz compiler's P2 optimisation pass propagates constants across basic
// blocks and folds arithmetic at compile time.  This program demonstrates
// several cases that the pass handles:
//
//   1. Simple constant folding (a + b where both are literals).
//   2. Chained operations (multiple dependent folds in one block).
//   3. Dead branch elimination (Jz/Jnz whose condition is constant).
//   4. Cross-block propagation (constant flows through an unconditional jump).
//
// None of the folded expressions need to perform runtime arithmetic — the
// compiler produces `MovI` / `MovConst` directly.

import std.io;
import std.core;

fn main() i32 {
    // ── 1. Simple constant arithmetic ────────────────────────────────────────
    const a: i32 = 6;
    const b: i32 = 7;
    const product: i32 = a * b;       // folded to 42 at compile time
    io.print("6 * 7 = ");
    io.println(core.int_to_str(product as i64));

    // ── 2. Chained folding ───────────────────────────────────────────────────
    const x: i32 = 3;
    const y: i32 = x + 2;             // 5
    const z: i32 = y * y - 1;         // 24
    io.print("(3+2)^2 - 1 = ");
    io.println(core.int_to_str(z as i64));

    // ── 3. Dead branch elimination ───────────────────────────────────────────
    // The condition `0 == 0` is always true; the else branch is dead code and
    // will be removed by the constprop pass + dead-register elimination.
    const always_true: bool = (0 == 0);
    var msg: &str;
    if (always_true) {
        msg = "branch taken (always)";
    } else {
        msg = "UNREACHABLE";          // never emitted in the binary
    }
    io.println(msg);

    // ── 4. Cross-block propagation ───────────────────────────────────────────
    // `val` is set once before a for-loop; the loop body uses it.
    // The compiler propagates `val = 100` into both blocks.
    const val: i32 = 100;
    var sum: i32 = 0;
    for i : 0..3 {
        sum = sum + val;              // each `val` usage is folded to 100
    }
    // sum == 300
    io.print("100 * 3 = ");
    io.println(core.int_to_str(sum as i64));

    ret 0;
}
