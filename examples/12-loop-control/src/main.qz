import std.io;

fn main() i32 {
    io.println("Processing queued jobs");
    var job: u32 = 0;
    for job < 10 {
        job += 1;
        if job == 8 {
            io.println("daily processing limit reached");
            break;
        }
        if job % 3 == 0 {
            io.println("job {} postponed", job);
            continue;
        }
        io.println("job {} completed", job);
    }

    ret 0;
}
