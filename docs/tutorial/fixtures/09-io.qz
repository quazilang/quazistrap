import std.fs;
import std.io;

fn write_greeting(path: str) Result[usize, FsError] {
    var file = File.create(path)?;
    ret file.write_str("Hello from Quazi!\n");
}

fn main() i32 {
    match fs.read_to_string("tutorial-input.txt") {
        Ok(content) => io.println("{}", content),
        Err(_) => io.println("Cannot read file"),
    };
    if (fs.exists("tutorial-input.txt")) {
        io.println("The file exists");
    }
    ret 0;
}
