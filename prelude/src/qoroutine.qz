// prelude.qoroutine — built-in qoroutines (D-019).
//
// `qo f(args)` is lowered by the parser to `__qo_spawn(|| f(args))`; the
// result is a `Qoroutine[T]` whose `join()` waits and returns `T`.
//
// M:N scheduler: qoroutines run on four OS worker threads started on first
// use. Each qoroutine owns a 256 KiB stack slot and a context entered with
// `quazi.context.switch`. Quazi has no global variables, so the scheduler
// lives in the `quazi.runtime.state` block:
//   +0 queue lock, +8 queue head, +16 queue tail,
//   +24 init state (0 none, 1 initializing, 2 ready), +32 stack arena,
//   +40 free slot indexes (i64 array), +48 free slot count,
//   +56 preemption enabled (the signal handler was installed).
// All stacks are slots of one arena; a slot's first word is its task, so code
// running on a qoroutine finds its task from the stack pointer
// (`quazi.stack.pointer` + `quazi.ptr.offset_from`, no thread-local storage).
// Task block (512 bytes):
//   +0 joinable (2 once finished), +8 result slot, +16 closure, +24 slot index,
//   +32 next in queue, +40 worker context, +48 type-erased runner,
//   +56 finished flag, +64 task context (272 bytes), +336 panicked flag,
//   +344 preemption hold count.
// A finished task is published as joinable by its worker only after the
// worker is back on its own stack, so `join` may free the task's stack.
//
// A panic inside a qoroutine prints its message, abandons the qoroutine's
// stack (pending destructors there do not run) and makes `join` return
// `Err(QoroutineError.Panicked)`; elsewhere a panic still ends the program.
//
// Preemption (Linux): every worker arms a 10 ms thread timer that sends
// SIGURG to it. The handler runs on the interrupted qoroutine's stack and, if
// the qoroutine holds no runtime lock (+344 is zero), switches to the worker
// from inside the signal frame; resuming the qoroutine returns from the
// handler and `rt_sigreturn` restores every register. The worker unblocks
// SIGURG again after each switch. A task that is not running always holds
// at least one preemption hold (fresh tasks start with one, voluntary and
// preempting switches take one), so a signal during the switch into a task
// cannot re-enter it. Windows, NetBSD and programs linking libc (where a
// preempted libc call could deadlock or migrate its thread state) are not
// preempted.
//
// Current limits: `join` outside a qoroutine yields its OS thread; at most
// `__qo_slot_count()` qoroutines are alive at once. Owned results move into
// the result slot once and out through `join`, which reads the slot only for
// a qoroutine that finished without panicking.

@intrinsic("quazi.runtime.state")
unsafe fn __qo_state() *u8;

@intrinsic("quazi.context.switch")
unsafe fn __qo_switch(save: *u8, restore: *u8) void;

@intrinsic("quazi.atomic.add")
unsafe fn __qo_atomic_add(target: *i64, delta: i64) i64;

@intrinsic("quazi.atomic.cas")
unsafe fn __qo_atomic_cas(target: *i64, expected: i64, desired: i64) i64;

@intrinsic("quazi.malloc")
unsafe fn __qo_malloc(size: usize) *u8;

@intrinsic("quazi.free")
unsafe fn __qo_free(ptr: *u8) void;

@intrinsic("quazi.memset")
unsafe fn __qo_memset(ptr: *u8, value: i32, size: usize) *u8;

@intrinsic("quazi.sleep_ms")
fn __qo_sleep_ms(ms: u64) void;

@intrinsic("quazi.stack.pointer")
unsafe fn __qo_stack_pointer() *u8;

@intrinsic("quazi.ptr.offset_from")
unsafe fn __qo_offset_from(p: *u8, base: *u8) isize;

@cfg(target_os = "windows")
@repr(C)
pub type __QoWorkerEntry = fn(*u8) u32;

@cfg(target_os = "linux")
@repr(C)
pub type __QoWorkerEntry = fn(*u8) *u8;

@cfg(target_os = "netbsd")
@repr(C)
pub type __QoWorkerEntry = fn(*u8) *u8;

@intrinsic("quazi.thread.spawn_arg")
unsafe fn __qo_spawn_thread(f: __QoWorkerEntry, arg: *u8) usize;

@repr(C)
pub type __QoTaskEntry = fn(*u8) void;

@repr(C)
pub type __QoSignalHandler = fn(i32, *u8, *u8) void;

@intrinsic("quazi.signal.install")
unsafe fn __qo_install_signal(signal: i32, handler: __QoSignalHandler) i64;

@cfg(target_os = "linux")
@syscall(186)
unsafe fn __qo_gettid() i64;

@cfg(target_os = "linux")
@syscall(222)
unsafe fn __qo_timer_create(clock: i64, event: *u8, timer: *u8) i64;

@cfg(target_os = "linux")
@syscall(223)
unsafe fn __qo_timer_settime(timer: i64, flags: i64, value: *u8, old: *u8) i64;

@cfg(target_os = "linux")
@syscall(14)
unsafe fn __qo_sigprocmask(how: i64, set: *u8, old: *u8, size: usize) i64;

fn __qo_preempt_signal() i32 { 23 }

// Send this worker thread SIGURG every 10 ms (Linux), if preemption is on.
@cfg(target_os = "linux")
unsafe fn __qo_arm_timer() void {
    if (*((__qo_state() + 56) as *i64) == 0) { ret; }
    const block: *u8 = __qo_malloc(128);
    __qo_memset(block, 0, 128);
    // struct sigevent: signo +8, notify +12 (SIGEV_THREAD_ID = 4), tid +16.
    *((block + 8) as *i32) = __qo_preempt_signal();
    *((block + 12) as *i32) = 4;
    *((block + 16) as *i32) = __qo_gettid() as i32;
    if (__qo_timer_create(1, block, block + 64) == 0) {
        // struct itimerspec: interval {0, 10 ms}, first expiry {0, 10 ms}.
        *((block + 80) as *i64) = 10000000;
        *((block + 96) as *i64) = 10000000;
        const timer: i32 = *((block + 64) as *i32);
        __qo_timer_settime(timer as i64, 0, block + 72, 0);
    }
}

@cfg(target_os = "windows")
unsafe fn __qo_arm_timer() void {}

@cfg(target_os = "netbsd")
unsafe fn __qo_arm_timer() void {}

// A preempting switch leaves SIGURG blocked on this worker: unblock it.
// `set` is the worker's signal set holding only SIGURG.
@cfg(target_os = "linux")
unsafe fn __qo_unblock_preemption(set: *u8) void {
    __qo_sigprocmask(1, set, 0, 8);
}

@cfg(target_os = "windows")
unsafe fn __qo_unblock_preemption(_set: *u8) void {}

@cfg(target_os = "netbsd")
unsafe fn __qo_unblock_preemption(_set: *u8) void {}

fn __qo_task_size() usize { 512 }
fn __qo_stack_size() usize { 262144 }

// Stack arena capacity: live qoroutines at once. Linux/NetBSD map the arena
// lazily; Windows commits heap memory, so it keeps a smaller arena.
@cfg(target_os = "windows")
fn __qo_slot_count() usize { 256 }

@cfg(target_os = "linux")
fn __qo_slot_count() usize { 1024 }

@cfg(target_os = "netbsd")
fn __qo_slot_count() usize { 1024 }

// While a qoroutine holds a runtime lock or switches voluntarily, the
// preemption handler must leave it alone.
unsafe fn __qo_hold() void {
    const task = __qo_current();
    if (task != 0) { *((task + 344) as *i64) = *((task + 344) as *i64) + 1; }
}

unsafe fn __qo_unhold() void {
    const task = __qo_current();
    if (task != 0) { *((task + 344) as *i64) = *((task + 344) as *i64) - 1; }
}

unsafe fn __qo_lock(state: *u8) void {
    __qo_hold();
    for (__qo_atomic_cas(state as *i64, 0, 1) != 0) { __qo_sleep_ms(0); }
}

unsafe fn __qo_unlock(state: *u8) void {
    __qo_atomic_cas(state as *i64, 1, 0);
    __qo_unhold();
}

unsafe fn __qo_enqueue(task: *u8) void {
    const state = __qo_state();
    *((task + 32) as **u8) = 0;
    __qo_lock(state);
    const tail: *u8 = *((state + 16) as **u8);
    if (tail == 0) { *((state + 8) as **u8) = task; } else { *((tail + 32) as **u8) = task; }
    *((state + 16) as **u8) = task;
    __qo_unlock(state);
}

unsafe fn __qo_dequeue() *u8 {
    const state = __qo_state();
    __qo_lock(state);
    const head: *u8 = *((state + 8) as **u8);
    if (head != 0) {
        const next: *u8 = *((head + 32) as **u8);
        *((state + 8) as **u8) = next;
        if (next == 0) { *((state + 16) as **u8) = 0; }
    }
    __qo_unlock(state);
    head
}

// One scheduling loop per worker thread; never returns.
unsafe fn __qo_worker_loop() void {
    const context: *u8 = __qo_malloc(280);
    const preempt_set: *u8 = context + 272;
    *(preempt_set as *i64) = 4194304; // 1 << (SIGURG - 1)
    __qo_arm_timer();
    for (true) {
        const task = __qo_dequeue();
        if (task == 0) { __qo_sleep_ms(0); continue; }
        *((task + 40) as **u8) = context;
        __qo_switch(context, task + 64);
        __qo_unblock_preemption(preempt_set);
        if (*((task + 56) as *i64) == 1) {
            __qo_atomic_add(task as *i64, 2);
        } else {
            __qo_enqueue(task);
        }
    }
}

@cfg(target_os = "windows")
@export("__quazi_qo_worker")
pub unsafe fn __qo_worker(_arg: *u8) u32 {
    __qo_worker_loop();
    ret 0;
}

@cfg(target_os = "linux")
@export("__quazi_qo_worker")
pub unsafe fn __qo_worker(_arg: *u8) *u8 {
    __qo_worker_loop();
    ret 0;
}

@cfg(target_os = "netbsd")
@export("__quazi_qo_worker")
pub unsafe fn __qo_worker(_arg: *u8) *u8 {
    __qo_worker_loop();
    ret 0;
}

// First code a qoroutine runs on its own stack; never returns.
@export("__quazi_qo_entry")
pub unsafe fn __qo_entry(task: *u8) void {
    // Fresh tasks start with one hold so the switch into them is safe.
    __qo_unhold();
    const runner: fn(*u8) void = *((task + 48) as *fn(*u8) void);
    runner(task);
    __qo_hold();
    // Both closures were stored through raw memory, which no owner cleans up:
    // release their environments (the call already consumed moved captures).
    __qo_free(*((task + 48) as **u8));
    *((task + 56) as *i64) = 1;
    __qo_switch(task + 64, *((task + 40) as **u8));
}

unsafe fn __qo_run[T](task: *u8) void {
    const f: fn() T = *((task + 16) as *fn() T);
    const value: T = f();
    *((task + 8) as *T) = value;
}

// Map the stack arena and start the workers exactly once.
unsafe fn __qo_init() void {
    const state = __qo_state();
    if (__qo_atomic_cas((state + 24) as *i64, 0, 1) == 0) {
        const slots = __qo_slot_count();
        const arena: *u8 = __qo_malloc(slots * __qo_stack_size());
        const free: *u8 = __qo_malloc(slots * 8);
        if (arena == 0 || free == 0) { panic("qoroutine stack arena allocation failed"); }
        for i : 0..slots { *((free + i * 8) as *i64) = i as i64; }
        *((state + 32) as **u8) = arena;
        *((state + 40) as **u8) = free;
        *((state + 48) as *i64) = slots as i64;
        const handler: __QoSignalHandler = __qo_preempt;
        if (__qo_install_signal(__qo_preempt_signal(), handler) == 0) {
            *((state + 56) as *i64) = 1;
        }
        __qo_atomic_cas((state + 24) as *i64, 1, 2);
        for i : 0..4 { __qo_spawn_thread(__qo_worker, 0); }
    }
    for (__qo_atomic_add((state + 24) as *i64, 0) != 2) { __qo_sleep_ms(0); }
}

unsafe fn __qo_take_slot() i64 {
    const state = __qo_state();
    __qo_lock(state);
    const count: i64 = *((state + 48) as *i64);
    var index: i64 = -1;
    if (count > 0) {
        index = *((*((state + 40) as **u8) + ((count - 1) as usize) * 8) as *i64);
        *((state + 48) as *i64) = count - 1;
    }
    __qo_unlock(state);
    index
}

unsafe fn __qo_release_slot(index: i64) void {
    const state = __qo_state();
    __qo_lock(state);
    const count: i64 = *((state + 48) as *i64);
    *((*((state + 40) as **u8) + (count as usize) * 8) as *i64) = index;
    *((state + 48) as *i64) = count + 1;
    __qo_unlock(state);
}

unsafe fn __qo_slot(index: i64) *u8 {
    *((__qo_state() + 32) as **u8) + (index as usize) * __qo_stack_size()
}

// The task whose stack this code runs on, or null outside qoroutines.
unsafe fn __qo_current() *u8 {
    const state = __qo_state();
    const arena: *u8 = *((state + 32) as **u8);
    if (arena == 0) { ret 0; }
    const offset: isize = __qo_offset_from(__qo_stack_pointer(), arena);
    const size: isize = (__qo_slot_count() * __qo_stack_size()) as isize;
    if (offset < 0 || offset >= size) { ret 0; }
    const index: i64 = (offset / (__qo_stack_size() as isize)) as i64;
    *(__qo_slot(index) as **u8)
}

// Let other qoroutines run: a qoroutine goes back to the run queue; any
// other thread yields its OS time slice.
unsafe fn __qo_yield() void {
    const task = __qo_current();
    if (task == 0) {
        __qo_sleep_ms(0);
        ret;
    }
    __qo_hold();
    __qo_switch(task + 64, *((task + 40) as **u8));
    __qo_unhold();
}

// SIGURG handler: move the interrupted qoroutine back to the run queue.
@export("__quazi_qo_preempt")
pub unsafe fn __qo_preempt(_signal: i32, _info: *u8, _context: *u8) void {
    const task = __qo_current();
    if (task == 0 || *((task + 344) as *i64) != 0) { ret; }
    __qo_hold();
    __qo_switch(task + 64, *((task + 40) as **u8));
    __qo_unhold();
}

// Whether the calling code runs on a qoroutine (for panic messages).
pub fn __qo_running() bool {
    unsafe { ret __qo_current() != 0; }
}

// Called by the panic handler after the message is printed: inside a
// qoroutine, mark it panicked and leave its stack for good; elsewhere return.
pub fn __qo_abandon_on_panic() void {
    unsafe {
        const task = __qo_current();
        if (task == 0) { ret; }
        __qo_hold();
        *((task + 336) as *i64) = 1;
        *((task + 56) as *i64) = 1;
        __qo_switch(task + 64, *((task + 40) as **u8));
    }
}

// Why `join` could not return the qoroutine's result.
pub enum QoroutineError {
    // The qoroutine panicked; its message was printed to stderr.
    Panicked,
}

// A running or finished qoroutine started by `qo`.
pub struct Qoroutine[T] {
    task: *u8,
}

// Target of the `qo f(args)` lowering: run `f` in a new qoroutine.
pub fn __qo_spawn[T](f: fn() T) Qoroutine[T] {
    var task: *u8 = 0;
    unsafe {
        task = __qo_malloc(__qo_task_size());
        if (task == 0) { panic("qoroutine allocation failed"); }
        __qo_memset(task, 0, __qo_task_size());
        *((task + 16) as *fn() T) = f;
        const runner: fn(*u8) void = |t| __qo_run[T](t);
        *((task + 48) as *fn(*u8) void) = runner;
        __qo_init();
        const index = __qo_take_slot();
        if (index < 0) { panic("too many live qoroutines"); }
        const stack: *u8 = __qo_slot(index);
        *(stack as **u8) = task;
        *((task + 24) as *i64) = index;
        *((task + 344) as *i64) = 1;
        const entry: __QoTaskEntry = __qo_entry;
        const top: *u8 = stack + __qo_stack_size();
        *((task + 64 + 48) as *__QoTaskEntry) = entry;
        *((task + 64 + 56) as **u8) = top - 72;
        *((task + 64 + 72) as **u8) = task;
        *((task + 64 + 80) as *u32) = 8064;
        *((task + 64 + 84) as *u16) = 895;
        *((task + 64 + 88) as **u8) = top;
        *((task + 64 + 96) as **u8) = stack;
        __qo_enqueue(task);
    }
    Qoroutine { task: task }
}

impl Qoroutine[T] {
    // Wait for the qoroutine to finish: its result, or an error if it panicked.
    pub fn join(self: Qoroutine[T]) Result[T, QoroutineError] {
        const task: *u8 = self.task;
        var panicked: bool = false;
        unsafe {
            for (__qo_atomic_add(task as *i64, 0) != 2) { __qo_yield(); }
            panicked = *((task + 336) as *i64) != 0;
            __qo_release_slot(*((task + 24) as *i64));
        }
        if (panicked) {
            unsafe { __qo_free(task); }
            ret Err(QoroutineError.Panicked);
        }
        // Only a finished qoroutine wrote its (possibly owned) result.
        var value: T;
        unsafe {
            value = *((task + 8) as *T);
            __qo_free(task);
        }
        Ok(value)
    }
}

// ── Channel[T] ───────────────────────────────────────────────────────────────
//
// A bounded FIFO shared by qoroutines and OS threads (D-019). The handle is
// reference counted: `clone()` adds an owner and each owner's automatic
// `free` releases one; the buffer goes away with the last owner. Blocking
// operations yield: a qoroutine gives its worker to others, any other thread
// yields its OS time slice.
//
// Block (64 bytes): +0 lock, +8 owners, +16 capacity, +24 count, +32 head,
// +40 closed, +48 buffer (capacity 8-byte slots).
// Values are stored as one 8-byte slot: send plain scalars for now.

pub struct Channel[T] {
    block: *u8,
}

unsafe fn __qo_channel_lock(block: *u8) void {
    __qo_hold();
    for (__qo_atomic_cas(block as *i64, 0, 1) != 0) { __qo_sleep_ms(0); }
}

unsafe fn __qo_channel_unlock(block: *u8) void {
    __qo_atomic_cas(block as *i64, 1, 0);
    __qo_unhold();
}

impl Channel[T] {
    // A channel buffering up to `capacity` values (at least one).
    pub fn new(capacity: usize) Channel[T] {
        var block: *u8 = 0;
        unsafe {
            const slots: usize = if (capacity == 0) { 1 } else { capacity };
            block = __qo_malloc(64);
            const buffer: *u8 = __qo_malloc(slots * 8);
            if (block == 0 || buffer == 0) { panic("channel allocation failed"); }
            __qo_memset(block, 0, 64);
            *((block + 8) as *i64) = 1;
            *((block + 16) as *i64) = slots as i64;
            *((block + 48) as **u8) = buffer;
        }
        Channel { block: block }
    }

    // Another owner of the same channel, e.g. to pass to a qoroutine.
    pub fn clone(self: &Channel[T]) Channel[T] {
        unsafe { __qo_atomic_add((self.block + 8) as *i64, 1); }
        Channel { block: self.block }
    }

    // Append `value`, waiting while the channel is full. Panics once closed.
    pub fn send(self: &Channel[T], value: T) void {
        unsafe {
            const block = self.block;
            for (true) {
                __qo_channel_lock(block);
                if (*((block + 40) as *i64) != 0) {
                    __qo_channel_unlock(block);
                    panic("send on a closed channel");
                }
                const capacity: i64 = *((block + 16) as *i64);
                const count: i64 = *((block + 24) as *i64);
                if (count < capacity) {
                    const tail: i64 = (*((block + 32) as *i64) + count) % capacity;
                    *((*((block + 48) as **u8) + (tail as usize) * 8) as *T) = value;
                    *((block + 24) as *i64) = count + 1;
                    __qo_channel_unlock(block);
                    ret;
                }
                __qo_channel_unlock(block);
                __qo_yield();
            }
        }
    }

    // The oldest value, waiting while the channel is empty; None once it is
    // closed and drained.
    pub fn receive(self: &Channel[T]) Option[T] {
        unsafe {
            const block = self.block;
            for (true) {
                __qo_channel_lock(block);
                const count: i64 = *((block + 24) as *i64);
                if (count > 0) {
                    const head: i64 = *((block + 32) as *i64);
                    const value: T = *((*((block + 48) as **u8) + (head as usize) * 8) as *T);
                    *((block + 32) as *i64) = (head + 1) % *((block + 16) as *i64);
                    *((block + 24) as *i64) = count - 1;
                    __qo_channel_unlock(block);
                    ret Some(value);
                }
                if (*((block + 40) as *i64) != 0) {
                    __qo_channel_unlock(block);
                    ret None;
                }
                __qo_channel_unlock(block);
                __qo_yield();
            }
        }
        None
    }

    // No more values will be sent; receivers drain what is buffered.
    pub fn close(self: &Channel[T]) void {
        unsafe {
            __qo_channel_lock(self.block);
            *((self.block + 40) as *i64) = 1;
            __qo_channel_unlock(self.block);
        }
    }

    pub fn free(self: Channel[T]) void {
        unsafe {
            if (self.block != 0 && __qo_atomic_add((self.block + 8) as *i64, -1) == 1) {
                __qo_free(*((self.block + 48) as **u8));
                __qo_free(self.block);
            }
            self.block = 0;
        }
    }
}
