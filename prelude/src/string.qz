// std.string — owned heap string (null-terminated, heap-allocated copy)

@intrinsic("quazi.strlen")
fn __string_strlen(s: str) usize;

@intrinsic("quazi.str_concat")
fn __string_str_concat(s1: str, s2: str) str;

@intrinsic("quazi.free")
fn __string_free(s: str) void;

pub struct String {
    data: str,
    len: usize,
    cap: usize,
}

impl String {
    pub fn new() String {
        ret String { data: "", len: 0, cap: 0 };
    }

    pub fn from(s: str) String {
        var n: usize = __string_strlen(s);
        var buf: str = __string_str_concat(s, "");
        ret String { data: buf, len: n, cap: n + 1 };
    }

    pub fn len(self: String) usize {
        ret self.len;
    }

    pub fn is_empty(self: String) bool {
        ret self.len == 0;
    }

    pub fn as_str(self: String) str {
        ret self.data;
    }

    pub fn push_str(self: String, s: str) String {
        var combined: str = __string_str_concat(self.data, s);
        var slen: usize = __string_strlen(s);
        var new_len: usize = self.len + slen;
        ret String { data: combined, len: new_len, cap: new_len + 1 };
    }

    pub fn concat(a: String, b: String) String {
        ret a.push_str(b.data);
    }

    pub fn free(self: String) void {
        if (self.cap > 0) {
            __string_free(self.data);
        }
    }
}
