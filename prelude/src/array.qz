// prelude.array — safe generic dynamic array backed by heap memory
import traits;
import panic.panic;
import layout.size_of;

@intrinsic("quazi.malloc")
fn __array_malloc(size: usize) *u8;

@intrinsic("quazi.free")
fn __array_free(ptr: *u8) void;

@intrinsic("quazi.realloc")
fn __array_realloc(ptr: *u8, size: usize) *u8;

// Internal: write val into base[idx * size_of[T]()]. @intrinsic bypasses S12.
@intrinsic("quazi.array.store")
fn __ptr_store[T](base: *u8, idx: usize, val: T) void;

// Internal: read base[idx * size_of[T]()].
@intrinsic("quazi.array.load")
fn __ptr_load[T](base: *u8, idx: usize) T;

// Why an array could not reserve storage.
pub enum ArrayReserveError {
    // The allocator could not provide the requested storage.
    AllocationFailed,
    // The requested element count exceeds the addressable byte size.
    CapacityOverflow,
}

// A growable list of values of type `T`, stored contiguously. It frees its
// elements and storage when it goes out of scope. `for value : array`
// consumes it; `for value : &array` reads copyable elements in place.
@contiguous_elements(element=T, pointer=ptr, length=len)
pub struct Array[T] {
    ptr: *u8,
    len: usize,
    cap: usize,
}

impl Array[T] {
    // An empty array.
    pub fn new() Array[T] {
        var array: Array[T] = Array.empty();
        if (array.try_reserve(8).is_err()) { panic("Array.new: allocation failed"); }
        ret array;
    }

    // An empty array that allocates only when first reserved or appended to.
    pub fn empty() Array[T] {
        ret Array { ptr: 0, len: 0, cap: 0 };
    }

    // Ensure room for at least `capacity` elements. On failure, the existing
    // storage and elements are preserved. Returns true if storage grew.
    pub fn try_reserve(self: &Array[T]!, capacity: usize) Result[bool, ArrayReserveError] {
        if (capacity <= self.cap) { ret Ok(false); }
        var stride: usize = size_of[T]();
        if (stride == 0) { stride = 1; }
        const limit: usize = 0x7FFFFFFFFFFFFFFF / stride;
        if (capacity > limit) { ret Err(ArrayReserveError.CapacityOverflow); }
        var target: usize = capacity;
        if (self.cap <= limit / 2 && self.cap * 2 > target) { target = self.cap * 2; }
        var storage: *u8;
        unsafe {
            if (self.ptr == 0) {
                storage = __array_malloc(target * stride);
            } else {
                storage = __array_realloc(self.ptr, target * stride);
            }
        }
        if (storage == 0) { ret Err(ArrayReserveError.AllocationFailed); }
        self.ptr = storage;
        self.cap = target;
        ret Ok(true);
    }

    // An array of the given values: `Array.from(1, 2, 3)`.
    pub fn from(...items: T) Array[T] {
        var result = Array.new();
        for item : items {
            result.push(item);
        }
        ret result;
    }

    // Appends `val` at the end, growing the storage when needed.
    pub fn push(self: &Array[T]!, val: T) void {
        if (self.len >= self.cap) {
            const capacity: usize = self.len + 1;
            if (self.try_reserve(capacity).is_err()) { panic("Array.push: allocation failed"); }
        }
        __ptr_store(self.ptr, self.len, val);
        self.len = self.len + 1;
    }

    // A copy of the element at `idx`; panics when `idx >= len()`.
    pub fn get(self: &Array[T], idx: usize) T {
        if (idx >= self.len) {
            panic("index out of bounds");
        }
        ret __ptr_load(self.ptr, idx);
    }

    // A shared reference to the element at `idx`; panics when `idx >= len()`.
    // The array stays borrowed while the reference is used (D-015).
    @contiguous_element_borrow pub fn get_ref(self: &Array[T], idx: usize) &T {
        // Lowered by the compiler to a bounds-checked element address.
        panic("Array.get_ref is lowered by the compiler");
    }

    // Replaces the element at `idx` with `val` and drops the old element;
    // panics when `idx >= len()`. (The compiler lowers this contract through a
    // checked load, recursive drop, then store.)
    @contiguous_element_replace pub fn set(self: &Array[T]!, idx: usize, val: T) void {
        if (idx >= self.len) {
            panic("index out of bounds");
        }
        __ptr_store(self.ptr, idx, val);
    }

    // Removes the element at `idx` and returns it, moving the later elements
    // down by one; panics when `idx >= len()`. (The compiler transfers the
    // slot to the caller and compacts the live range.)
    @contiguous_element_remove pub fn remove(self: &Array[T]!, idx: usize) T {
        if (idx >= self.len) {
            panic("index out of bounds");
        }
        ret __ptr_load(self.ptr, idx);
    }

    // The number of elements.
    pub fn len(self: &Array[T]) usize {
        ret self.len;
    }

    // Whether the array has no elements.
    pub fn is_empty(self: &Array[T]) bool {
        ret self.len == 0;
    }

    // Exposes the first contiguous element for FFI-style borrowed slices.
    // The pointer is invalidated by any operation that can reallocate or free
    // this array. Callers must stay within len elements and preserve valid
    // initialized values and ownership invariants when writing through it.
    pub unsafe fn as_ptr(self: &Array[T]) *T {
        ret self.ptr as *T;
    }

    // Frees the storage; called automatically at the end of scope.
    pub fn free(self: Array[T]) void {
        if (self.ptr != 0) {
            unsafe { __array_free(self.ptr); }
        }
        self.ptr = 0;
        self.len = 0;
        self.cap = 0;
    }
}

impl Index[usize, T] for Array[T] {
    // `array[i]`: the element at `i`; panics when out of range.
    pub fn index(self: &Array[T], i: usize) T {
        ret self.get(i);
    }
}

impl AsRef[Array[T]] for Array[T] {
    // The array itself.
    fn as_ref(self: &Array[T]) &Array[T] { ret self; }
}
