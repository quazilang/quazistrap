// prelude.traits — core language traits

// ── Display ──────────────────────────────────────────────────────────────────
// Human-readable text: `to_string()` returns an owned String (maintainer
// answer В9В: there is no borrowed `to_str()`; numbers are formatted into
// their own buffer, which is safe in every thread).
pub trait Display {
    fn to_string(self: &Self) String;
}

// ── Debug ────────────────────────────────────────────────────────────────────
// Programmer-readable representation (includes type info, escapes, etc.).
pub trait Debug {
    fn debug_str() &str;
}

// ── Eq ───────────────────────────────────────────────────────────────────────
// Value equality for generic code (`K: Eq`): reflexive, symmetric and
// transitive. Integers, `bool`, `str` and `String` implement it.
pub trait Eq {
    fn eq(self: &Self, other: &Self) bool;
}

// ── Ord ──────────────────────────────────────────────────────────────────────
// cmp returns negative if self < other, 0 if equal, positive if self > other.
pub trait Ord[T] {
    fn cmp(other: T) i32;
    fn lt(other: T) bool;
    fn le(other: T) bool;
    fn gt(other: T) bool;
    fn ge(other: T) bool;
}

// ── Clone ────────────────────────────────────────────────────────────────────
pub trait Clone {
    fn clone() Self;
}

// ── Copy ─────────────────────────────────────────────────────────────────────
// A value that may be duplicated bit for bit: using it does not move it.
// Integers, floats, `bool`, `str`, shared references and raw pointers are
// Copy; a struct is Copy through `@derive(Copy)` or `impl Copy for S {}` when
// every field is Copy. A generic parameter is Copy only under `T: Copy`.
pub trait Copy {
}

// ── AsRef ────────────────────────────────────────────────────────────────────
// A cheap shared view of `self` as a `&T`, for generic code that accepts any
// type which can lend a `T` (`fn show[S: AsRef[String]](value: &S)`). The
// returned reference borrows `self`.
pub trait AsRef[T] {
    fn as_ref(self: &Self) &T;
}

// ── Default ──────────────────────────────────────────────────────────────────
pub trait Default {
    fn default() Self;
}

// ── Hash ─────────────────────────────────────────────────────────────────────
// A 64-bit hash consistent with `Eq`: equal values have equal hashes.
// Integers, `bool`, `str` and `String` implement it; the values are not
// stable across compiler versions and must not be persisted.
pub trait Hash {
    fn hash(self: &Self) u64;
}

// ── Iterator ─────────────────────────────────────────────────────────────────
pub trait Iterator[T] {
    fn next() Option[T];
    fn has_next() bool;
}

// ── Into / From ───────────────────────────────────────────────────────────────
pub trait Into[T] {
    fn into() T;
}

// Conversion from `T`: `Target.from(value)`.
pub trait From[T] {
    fn from(val: T) Self;
}

// ── Drop ─────────────────────────────────────────────────────────────────────
pub trait Drop {
    fn drop() void;
}

// ── Index ────────────────────────────────────────────────────────────────────
pub trait Index[I, O] {
    fn index(self: &Self, i: I) O;
}

// ── Write ─────────────────────────────────────────────────────────────────────
// Implemented by Stdout and Stderr. Their formatting methods (`writef`,
// `writelnf`) take `...args: Display` and are inherent methods.
pub trait Write {
    fn write(self: Self, s: str) void;
    fn writeln(self: Self, s: str) void;
}

// ── Display impls for primitives ─────────────────────────────────────────────

impl Display for i8 {
    // The decimal text of the value as an owned String.
    pub fn to_string(self: &i8) String { const value: i8 = *self; ret "{value}"; }
}

impl Display for i16 {
    // The decimal text of the value as an owned String.
    pub fn to_string(self: &i16) String { const value: i16 = *self; ret "{value}"; }
}

impl Display for i32 {
    // The decimal text of the value as an owned String.
    pub fn to_string(self: &i32) String { const value: i32 = *self; ret "{value}"; }
}

impl Display for i64 {
    // The decimal text of the value as an owned String.
    pub fn to_string(self: &i64) String { const value: i64 = *self; ret "{value}"; }
}

impl Display for u8 {
    // The decimal text of the value as an owned String.
    pub fn to_string(self: &u8) String { const value: u8 = *self; ret "{value}"; }
}

impl Display for u16 {
    // The decimal text of the value as an owned String.
    pub fn to_string(self: &u16) String { const value: u16 = *self; ret "{value}"; }
}

impl Display for u32 {
    // The decimal text of the value as an owned String.
    pub fn to_string(self: &u32) String { const value: u32 = *self; ret "{value}"; }
}

impl Display for u64 {
    // The decimal text of the value as an owned String.
    pub fn to_string(self: &u64) String { const value: u64 = *self; ret "{value}"; }
}

impl Display for isize {
    // The decimal text of the value as an owned String.
    pub fn to_string(self: &isize) String { const value: isize = *self; ret "{value}"; }
}

impl Display for usize {
    // The decimal text of the value as an owned String.
    pub fn to_string(self: &usize) String { const value: usize = *self; ret "{value}"; }
}

impl Display for f16 {
    // The decimal text of the value as an owned String.
    pub fn to_string(self: &f16) String { const value: f64 = (*self) as f64; ret value.to_string(); }
}

impl Display for f32 {
    // The decimal text of the value as an owned String.
    pub fn to_string(self: &f32) String { const value: f32 = *self; ret "{value}"; }
}

impl Display for f64 {
    // The decimal text of the value as an owned String.
    pub fn to_string(self: &f64) String { const value: f64 = *self; ret "{value}"; }
}

impl Display for bool {
    // The decimal text of the value as an owned String.
    pub fn to_string(self: &bool) String { const value: bool = *self; ret "{value}"; }
}

impl Display for str {
    // An owned copy of the text.
    pub fn to_string(self: &str) String { ret String.from(self); }
}

// Owned text exposes borrowed display views and explicit owned copies.
impl String {
    // An owned copy of the text.
    pub fn to_string(self: &String) String { ret String.from(self.as_str()); }
}

// ── Operator overloading ──────────────────────────────────────────────────────
pub trait Add[T] { fn add(rhs: T) T; }
// Overloads `-`.
pub trait Sub[T] { fn sub(rhs: T) T; }
// Overloads `*`.
pub trait Mul[T] { fn mul(rhs: T) T; }
// Overloads `/`.
pub trait Div[T] { fn div(rhs: T) T; }
// Overloads `%`.
pub trait Rem[T] { fn rem(rhs: T) T; }
// Overloads unary `-`.
pub trait Neg    { fn neg() Self; }
// Overloads `&`.
pub trait BitAnd[T] { fn bit_and(rhs: T) T; }
// Overloads `|`.
pub trait BitOr[T]  { fn bit_or(rhs: T) T; }
// Overloads `^`.
pub trait BitXor[T] { fn bit_xor(rhs: T) T; }
// Overloads `<<`.
pub trait Shl[T] { fn shl(n: T) T; }
// Overloads `>>`.
pub trait Shr[T] { fn shr(n: T) T; }
