// prelude.traits — core language traits

// ── Display ──────────────────────────────────────────────────────────────────
// Human-readable text: `to_string()` returns an owned String (maintainer
// answer В9В: there is no borrowed `to_str()`; numbers are formatted into
// their own buffer, which is safe in every thread).
pub trait Display {
    fn to_string() String;
}

// ── Debug ────────────────────────────────────────────────────────────────────
// Programmer-readable representation (includes type info, escapes, etc.).
pub trait Debug {
    fn debug_str() &str;
}

// ── Eq ───────────────────────────────────────────────────────────────────────
pub trait Eq[T] {
    fn eq(other: T) bool;
    fn ne(other: T) bool;
}

// ── Ord ──────────────────────────────────────────────────────────────────────
// cmp returns negative if self < other, 0 if equal, positive if self > other.
pub trait Ord[T] {
    fn cmp(other: T) i32;
    fn lt(other: T) bool;
    fn le(other: T) bool;
    fn gt(other: T) bool;
    fn ge(other: T) bool;
}

// ── Clone ────────────────────────────────────────────────────────────────────
pub trait Clone {
    fn clone() Self;
}

// ── Default ──────────────────────────────────────────────────────────────────
pub trait Default {
    fn default() Self;
}

// ── Hash ─────────────────────────────────────────────────────────────────────
pub trait Hash {
    fn hash() u64;
}

// ── Iterator ─────────────────────────────────────────────────────────────────
pub trait Iterator[T] {
    fn next() Option[T];
    fn has_next() bool;
}

// ── Into / From ───────────────────────────────────────────────────────────────
pub trait Into[T] {
    fn into() T;
}

// Conversion from `T`: `Target.from(value)`.
pub trait From[T] {
    fn from(val: T) Self;
}

// ── Drop ─────────────────────────────────────────────────────────────────────
pub trait Drop {
    fn drop() void;
}

// ── Index ────────────────────────────────────────────────────────────────────
pub trait Index[I, O] {
    fn index(self: &Self, i: I) O;
}

// ── Write ─────────────────────────────────────────────────────────────────────
// Implemented by Stdout and Stderr. writef/writelnf accept a pre-formatted
// string; the compiler auto-formats when called with multiple arguments.
pub trait Write {
    fn write(self: Self, s: str) void;
    fn writeln(self: Self, s: str) void;
    fn writef(self: Self, s: str) void;
    fn writelnf(self: Self, s: str) void;
}

// ── Display impls for primitives ─────────────────────────────────────────────

impl Display for i8 {
    // The decimal text of the value as an owned String.
    pub fn to_string(self: i8) String { ret "{self}"; }
}

impl Display for i16 {
    // The decimal text of the value as an owned String.
    pub fn to_string(self: i16) String { ret "{self}"; }
}

impl Display for i32 {
    // The decimal text of the value as an owned String.
    pub fn to_string(self: i32) String { ret "{self}"; }
}

impl Display for i64 {
    // The decimal text of the value as an owned String.
    pub fn to_string(self: i64) String { ret "{self}"; }
}

impl Display for u8 {
    // The decimal text of the value as an owned String.
    pub fn to_string(self: u8) String { ret "{self}"; }
}

impl Display for u16 {
    // The decimal text of the value as an owned String.
    pub fn to_string(self: u16) String { ret "{self}"; }
}

impl Display for u32 {
    // The decimal text of the value as an owned String.
    pub fn to_string(self: u32) String { ret "{self}"; }
}

impl Display for u64 {
    // The decimal text of the value as an owned String.
    pub fn to_string(self: u64) String { ret "{self}"; }
}

impl Display for isize {
    // The decimal text of the value as an owned String.
    pub fn to_string(self: isize) String { ret "{self}"; }
}

impl Display for usize {
    // The decimal text of the value as an owned String.
    pub fn to_string(self: usize) String { ret "{self}"; }
}

impl Display for f16 {
    // The decimal text of the value as an owned String.
    pub fn to_string(self: f16) String { ret (self as f64).to_string(); }
}

impl Display for f32 {
    // The decimal text of the value as an owned String.
    pub fn to_string(self: f32) String { ret "{self}"; }
}

impl Display for f64 {
    // The decimal text of the value as an owned String.
    pub fn to_string(self: f64) String { ret "{self}"; }
}

impl Display for bool {
    // The decimal text of the value as an owned String.
    pub fn to_string(self: bool) String { ret "{self}"; }
}

impl Display for str {
    // An owned copy of the text.
    pub fn to_string(self: &str) String { ret String.from(self); }
}

// Owned text exposes borrowed display views and explicit owned copies.
impl String {
    // An owned copy of the text.
    pub fn to_string(self: &String) String { ret String.from(self.as_str()); }
}

// ── Operator overloading ──────────────────────────────────────────────────────
pub trait Add[T] { fn add(rhs: T) T; }
// Overloads `-`.
pub trait Sub[T] { fn sub(rhs: T) T; }
// Overloads `*`.
pub trait Mul[T] { fn mul(rhs: T) T; }
// Overloads `/`.
pub trait Div[T] { fn div(rhs: T) T; }
// Overloads `%`.
pub trait Rem[T] { fn rem(rhs: T) T; }
// Overloads unary `-`.
pub trait Neg    { fn neg() Self; }
// Overloads `&`.
pub trait BitAnd[T] { fn bit_and(rhs: T) T; }
// Overloads `|`.
pub trait BitOr[T]  { fn bit_or(rhs: T) T; }
// Overloads `^`.
pub trait BitXor[T] { fn bit_xor(rhs: T) T; }
// Overloads `<<`.
pub trait Shl[T] { fn shl(n: T) T; }
// Overloads `>>`.
pub trait Shr[T] { fn shr(n: T) T; }
