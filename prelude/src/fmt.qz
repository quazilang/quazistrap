// prelude.fmt — owned UTF-8 formatting results
import string;

@intrinsic("quazi.str.byte_at")
fn __format_byte_at(text: str, index: usize) u8;

// A new String: `a` followed by `b`.
pub fn concat(a: str, b: str) String {
    var result = String.from(a);
    result.push_str(b);
    ret result;
}

// Replaces each `{}` in `template` by the text of the next value; `{{` and
// `}}` are literal braces. Without values the template is returned as it is
// (a text that is not a literal template is never re-parsed for braces).
// Each value arrives as its display text (`...args: Display`, D-024).
pub fn format(template: str, ...args: Display) String {
    if args.len() == 0 {
        ret String.from(template);
    }
    var result = String.new();
    const length = template.bytes_len();
    var index: usize = 0;
    var scalar: usize = 0;
    var argument: usize = 0;
    for (index < length) {
        const first = __format_byte_at(template, index);
        if ((first == 123 || first == 125) && index + 1 < length && __format_byte_at(template, index + 1) == first) {
            if (first == 123) { result.push_str("{{"); }
            else { result.push_str("}}"); }
            index += 2;
            scalar += 2;
        } else if (first == 123 && index + 1 < length && __format_byte_at(template, index + 1) == 125) {
            if (argument < args.len()) {
                result.push_str(args[argument]);
                argument++;
            } else {
                result.push_str("{{}}");
            }
            index += 2;
            scalar += 2;
        } else {
            // Slice whole Unicode scalars; a non-ASCII byte alone is not UTF-8.
            const piece = template[scalar:scalar + 1];
            result.push_str(piece.as_str());
            if (first < 128) { index++; }
            else if (first < 224) { index += 2; }
            else if (first < 240) { index += 3; }
            else { index += 4; }
            scalar++;
        }
    }
    ret result;
}
