// prelude.fmt — owned UTF-8 formatting results
import string;

@intrinsic("quazi.str.byte_at")
fn __format_byte_at(text: str, index: usize) u8;

pub fn concat(a: str, b: str) String {
    const left = String.from(a);
    ret left.push_str(b);
}

// Call-site coercion supplies borrowed display views. Copy each view while it
// remains alive and transfer the final owner instead of detaching its buffer.
pub fn format(template: str, ...args: str) String {
    var result = String.new();
    const length = template.bytes_len();
    var index: usize = 0;
    var scalar: usize = 0;
    var argument: usize = 0;
    for (index < length) {
        const first = __format_byte_at(template, index);
        if ((first == 123 || first == 125) && index + 1 < length && __format_byte_at(template, index + 1) == first) {
            if (first == 123) { result = result.push_str("{"); }
            else { result = result.push_str("}"); }
            index += 2;
            scalar += 2;
        } else if (first == 123 && index + 1 < length && __format_byte_at(template, index + 1) == 125) {
            if (argument < args.len()) {
                result = result.push_str(args[argument]);
                argument++;
            } else {
                result = result.push_str("{}");
            }
            index += 2;
            scalar += 2;
        } else {
            // Slice whole Unicode scalars; a non-ASCII byte alone is not UTF-8.
            const piece = template[scalar:scalar + 1];
            result = result.push_str(piece.as_str());
            if (first < 128) { index++; }
            else if (first < 224) { index += 2; }
            else if (first < 240) { index += 3; }
            else { index += 4; }
            scalar++;
        }
    }
    ret result;
}
