// prelude.box — heap-allocated smart pointer Box[T]

@intrinsic("quazi.array.store")
fn __box_write(base: *u8, idx: usize, val: usize) void;

@intrinsic("quazi.array.load")
fn __box_read(base: *u8, idx: usize) usize;

@intrinsic("quazi.malloc")
unsafe fn __box_malloc(size: usize) *u8;

@intrinsic("quazi.free")
unsafe fn __box_free(ptr: *u8) void;

pub struct Box[T] {
    ptr: *u8,
}

impl Box[T] {
    pub fn new(val: T) Box[T] {
        var p: *u8;
        unsafe { p = __box_malloc(8); }
        __box_write(p, 0, val);
        ret Box { ptr: p };
    }

    pub fn get(self: Box[T]) T {
        ret __box_read(self.ptr, 0);
    }

    pub fn free(self: Box[T]) void {
        unsafe { __box_free(self.ptr); }
    }
}
