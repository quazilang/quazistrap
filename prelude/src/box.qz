// prelude.box — heap-allocated smart pointer Box[T]
import layout.size_of;

@intrinsic("quazi.array.store")
fn __box_write[T](base: *u8, idx: usize, val: T) void;

@intrinsic("quazi.array.load")
fn __box_read[T](base: *u8, idx: usize) T;

@intrinsic("quazi.malloc")
unsafe fn __box_malloc(size: usize) *u8;

@intrinsic("quazi.free")
unsafe fn __box_free(ptr: *u8) void;

// An owned value of type `T` stored on the heap; the storage is freed with
// the box.
pub struct Box[T] {
    ptr: *u8,
}

impl Box[T] {
    // A box holding `val`.
    pub fn new(val: T) Box[T] {
        var p: *u8;
        unsafe { p = __box_malloc(size_of[T]()); }
        if (p == 0) { panic("Box.new: allocation failed"); }
        __box_write(p, 0, val);
        ret Box { ptr: p };
    }

    // Moves the value out of the box.
    pub fn get(self: Box[T]) T {
        const value: T = __box_read(self.ptr, 0);
        unsafe { __box_free(self.ptr); }
        self.ptr = 0;
        ret value;
    }

    // Drops the value and frees its storage at the end of scope.
    pub fn free(self: Box[T]) void {
        if (self.ptr != 0) {
            const _value: T = __box_read(self.ptr, 0);
            unsafe { __box_free(self.ptr); }
            self.ptr = 0;
        }
    }
}
