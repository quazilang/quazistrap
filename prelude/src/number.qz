// Primitive numeric convenience methods implemented in Quazi.

import panic.panic;

// Two's-complement 64-bit arithmetic without overflow checks; narrower types
// truncate the result back with `as` (which keeps the low bits).
@intrinsic("quazi.int.wrapping_add")
fn __wrapping_add(left: u64, right: u64) u64;
@intrinsic("quazi.int.wrapping_sub")
fn __wrapping_sub(left: u64, right: u64) u64;
@intrinsic("quazi.int.wrapping_mul")
fn __wrapping_mul(left: u64, right: u64) u64;

fn __u64_greater(left: u64, right: u64) bool {
    const left_high: u64 = left >> 63;
    const right_high: u64 = right >> 63;
    if (left_high != right_high) { ret left_high != 0; }
    ret left > right;
}

fn __gcd_u64(left_value: u64, right_value: u64) u64 {
    var left: u64 = left_value;
    var right: u64 = right_value;
    if (left == 0) { ret right; }
    if (right == 0) { ret left; }
    var shift: u32 = 0;
    for (((left | right) & 1) == 0) {
        left = left >> 1;
        right = right >> 1;
        shift++;
    }
    for ((left & 1) == 0) { left = left >> 1; }
    for (right != 0) {
        for ((right & 1) == 0) { right = right >> 1; }
        if (__u64_greater(left, right)) {
            const swap: u64 = left;
            left = right;
            right = swap;
        }
        right = right - left;
    }
    ret left << shift;
}

fn __magnitude_i64(value: i64) u64 {
    if (value < 0) { ret ((-(value + 1)) as u64) + 1; }
    ret value as u64;
}

impl i32 {
    // Arithmetic that wraps around at the bounds of `i32` instead of
    // panicking on overflow (hashes, random number generators, checksums).
    pub fn wrapping_add(self: i32, other: i32) i32 { ret __wrapping_add(self as u64, other as u64) as i32; }
    // `self - other`, wrapping around at the bounds of the type.
    pub fn wrapping_sub(self: i32, other: i32) i32 { ret __wrapping_sub(self as u64, other as u64) as i32; }
    // `self * other`, wrapping around at the bounds of the type.
    pub fn wrapping_mul(self: i32, other: i32) i32 { ret __wrapping_mul(self as u64, other as u64) as i32; }
    // `-self`, wrapping around at the bounds of the type (`MIN` stays `MIN`).
    pub fn wrapping_neg(self: i32) i32 { ret __wrapping_sub(0, self as u64) as i32; }

    // The absolute value; panics for `MIN`, whose absolute value does not fit.
    pub fn abs(self: i32) i32 {
        if (self == -2147483648) { panic("i32.abs() overflow"); }
        if (self < 0) { ret -self; }
        ret self;
    }

    // `self` raised to `exponent`; panics when the result overflows the type.
    pub fn pow(self: i32, exponent: u32) i32 {
        var base: i32 = self;
        var power: u32 = exponent;
        var result: i32 = 1;
        for (power > 0) {
            if ((power & 1) == 1) { result = result * base; }
            power = power >> 1;
            if (power > 0) { base = base * base; }
        }
        ret result;
    }

    // The greatest common divisor (non-negative); `gcd(0, 0)` is 0. Panics when
    // the result does not fit the type.
    pub fn gcd(self: i32, other: i32) i32 {
        const value: u64 = __gcd_u64(__magnitude_i64(self as i64), __magnitude_i64(other as i64));
        if (value > 2147483647) { panic("i32.gcd() result overflow"); }
        ret value as i32;
    }
    // The least common multiple; 0 when either operand is 0. Panics when the
    // result does not fit the type.
    pub fn lcm(self: i32, other: i32) i32 {
        if (self == 0 || other == 0) { ret 0; }
        ret (self / self.gcd(other) * other).abs();
    }
    // Whether the value is divisible by 2.
    pub fn is_even(self: i32) bool { ret self % 2 == 0; }
    // Whether the value is not divisible by 2.
    pub fn is_odd(self: i32) bool { ret self % 2 != 0; }
}

impl i64 {
    // Arithmetic that wraps around at the bounds of `i64` instead of
    // panicking on overflow (hashes, random number generators, checksums).
    pub fn wrapping_add(self: i64, other: i64) i64 { ret __wrapping_add(self as u64, other as u64) as i64; }
    // `self - other`, wrapping around at the bounds of the type.
