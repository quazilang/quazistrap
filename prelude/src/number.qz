    // Whether the value is divisible by 2.
    pub fn is_even(self: i64) bool { ret self % 2 == 0; }
    // Whether the value is not divisible by 2.
    pub fn is_odd(self: i64) bool { ret self % 2 != 0; }
}

impl isize {
    // Arithmetic that wraps around at the bounds of `isize` instead of
    // panicking on overflow (hashes, random number generators, checksums).
    pub fn wrapping_add(self: isize, other: isize) isize { ret __wrapping_add(self as u64, other as u64) as isize; }
    // `self - other`, wrapping around at the bounds of the type.
    pub fn wrapping_sub(self: isize, other: isize) isize { ret __wrapping_sub(self as u64, other as u64) as isize; }
    // `self * other`, wrapping around at the bounds of the type.
    pub fn wrapping_mul(self: isize, other: isize) isize { ret __wrapping_mul(self as u64, other as u64) as isize; }
    // `-self`, wrapping around at the bounds of the type (`MIN` stays `MIN`).
    pub fn wrapping_neg(self: isize) isize { ret __wrapping_sub(0, self as u64) as isize; }

    // The absolute value; panics for `MIN`, whose absolute value does not fit.
    pub fn abs(self: isize) isize {
        if (self == ((-9223372036854775807 - 1) as isize)) { panic("isize.abs() overflow"); }
        if (self < 0) { ret -self; }
        ret self;
    }

    // `self` raised to `exponent`; panics when the result overflows the type.
    pub fn pow(self: isize, exponent: u32) isize {
        var base: isize = self;
        var power: u32 = exponent;
        var result: isize = 1;
        for (power > 0) {
            if ((power & 1) == 1) { result = result * base; }
            power = power >> 1;
            if (power > 0) { base = base * base; }
        }
        ret result;
    }

    // The greatest common divisor (non-negative); `gcd(0, 0)` is 0. Panics when
    // the result does not fit the type.
    pub fn gcd(self: isize, other: isize) isize {
        const value: u64 = __gcd_u64(
            __magnitude_i64(self as i64), __magnitude_i64(other as i64)
        );
        if (value > 9223372036854775807) { panic("isize.gcd() result overflow"); }
        ret value as isize;
    }
    // The least common multiple; 0 when either operand is 0. Panics when the
    // result does not fit the type.
    pub fn lcm(self: isize, other: isize) isize {
        if (self == 0 || other == 0) { ret 0; }
        ret (self / self.gcd(other) * other).abs();
    }
    // Whether the value is divisible by 2.
    pub fn is_even(self: isize) bool { ret self % 2 == 0; }
    // Whether the value is not divisible by 2.
    pub fn is_odd(self: isize) bool { ret self % 2 != 0; }
}

