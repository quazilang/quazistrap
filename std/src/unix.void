// std.unix — raw Linux x86-64 syscall bindings
// Every function maps 1:1 to a Linux syscall via @syscall.
// Not available on Windows (@syscall emits a no-op there).
// Struct pointer args use usize (opaque pointer); callers construct them
// manually or via std.mem helpers until void has a proper FFI struct layout.
//
// Conventions:
//   fd:    i32   — file descriptor
//   path:  str   — pointer to null-terminated C string
//   buf:   str   — pointer to byte buffer (not necessarily null-terminated)
//   count: usize — byte count / size_t
//   isize       — ssize_t / signed return
//   usize       — void* / pointer-sized value
//   u32         — unsigned int (mode_t, uid_t, gid_t)
//   i64         — off_t, time_t

// ── File I/O ─────────────────────────────────────────────────────────────────

@syscall("read")
pub fn read(fd: i32, buf: str, count: usize) isize;

@syscall("write")
pub fn write(fd: i32, buf: str, count: usize) isize;

// flags: O_RDONLY=0, O_WRONLY=1, O_RDWR=2, O_CREAT=64, O_TRUNC=512, O_APPEND=1024
@syscall("open")
pub fn open(path: str, flags: i32, mode: u32) i32;

@syscall("close")
pub fn close(fd: i32) i32;

// statbuf: pointer to struct stat (108 bytes on x86-64)
@syscall("stat")
pub fn stat(path: str, statbuf: usize) i32;

@syscall("fstat")
pub fn fstat(fd: i32, statbuf: usize) i32;

@syscall("lstat")
pub fn lstat(path: str, statbuf: usize) i32;

// fds: pointer to struct pollfd[]; nfds: count; timeout: ms (-1 = forever)
@syscall("poll")
pub fn poll(fds: usize, nfds: usize, timeout: i32) i32;

// whence: SEEK_SET=0, SEEK_CUR=1, SEEK_END=2
@syscall("lseek")
pub fn lseek(fd: i32, offset: i64, whence: i32) i64;

// pread64 / pwrite64 — positional read/write (no seek side effect)
@syscall("pread64")
pub fn pread64(fd: i32, buf: str, count: usize, offset: i64) isize;

@syscall("pwrite64")
pub fn pwrite64(fd: i32, buf: str, count: usize, offset: i64) isize;

// iov: pointer to struct iovec[]; iovcnt: vector count
@syscall("readv")
pub fn readv(fd: i32, iov: usize, iovcnt: i32) isize;

@syscall("writev")
pub fn writev(fd: i32, iov: usize, iovcnt: i32) isize;

// mode: R_OK=4, W_OK=2, X_OK=1, F_OK=0
@syscall("access")
pub fn access(path: str, mode: i32) i32;

// pipe — write end in pipefd[1], read end in pipefd[0]
@syscall("pipe")
pub fn pipe(pipefd: usize) i32;

@syscall("pipe2")
pub fn pipe2(pipefd: usize, flags: i32) i32;

// select — readfds/writefds/exceptfds: pointer to fd_set; timeout: pointer to struct timeval
@syscall("select")
pub fn select(nfds: i32, readfds: usize, writefds: usize, exceptfds: usize, timeout: usize) i32;

@syscall("dup")
pub fn dup(oldfd: i32) i32;

@syscall("dup2")
pub fn dup2(oldfd: i32, newfd: i32) i32;

@syscall("dup3")
pub fn dup3(oldfd: i32, newfd: i32, flags: i32) i32;

@syscall("ioctl")
pub fn ioctl(fd: i32, request: usize, arg: usize) i32;

// cmd: F_DUPFD=0, F_GETFD=1, F_SETFD=2, F_GETFL=3, F_SETFL=4
@syscall("fcntl")
pub fn fcntl(fd: i32, cmd: i32, arg: i64) i32;

// operation: LOCK_SH=1, LOCK_EX=2, LOCK_NB=4, LOCK_UN=8
@syscall("flock")
pub fn flock(fd: i32, operation: i32) i32;

@syscall("fsync")
pub fn fsync(fd: i32) i32;

@syscall("fdatasync")
pub fn fdatasync(fd: i32) i32;

@syscall("truncate")
pub fn truncate(path: str, length: i64) i32;

@syscall("ftruncate")
pub fn ftruncate(fd: i32, length: i64) i32;

// dirp: pointer to struct dirent buffer; count: buffer size
@syscall("getdents")
pub fn getdents(fd: i32, dirp: usize, count: usize) isize;

@syscall("getdents64")
pub fn getdents64(fd: i32, dirp: usize, count: usize) isize;

@syscall("getcwd")
pub fn getcwd(buf: str, size: usize) isize;

@syscall("chdir")
pub fn chdir(path: str) i32;

@syscall("fchdir")
pub fn fchdir(fd: i32) i32;

@syscall("rename")
pub fn rename(oldpath: str, newpath: str) i32;

@syscall("renameat")
pub fn renameat(olddirfd: i32, oldpath: str, newdirfd: i32, newpath: str) i32;

@syscall("mkdir")
pub fn mkdir(path: str, mode: u32) i32;

@syscall("mkdirat")
pub fn mkdirat(dirfd: i32, path: str, mode: u32) i32;

@syscall("rmdir")
pub fn rmdir(path: str) i32;

@syscall("creat")
pub fn creat(path: str, mode: u32) i32;

@syscall("link")
pub fn link(oldpath: str, newpath: str) i32;

@syscall("linkat")
pub fn linkat(olddirfd: i32, oldpath: str, newdirfd: i32, newpath: str, flags: i32) i32;

@syscall("unlink")
pub fn unlink(path: str) i32;

@syscall("unlinkat")
pub fn unlinkat(dirfd: i32, path: str, flags: i32) i32;

@syscall("symlink")
pub fn symlink(target: str, linkpath: str) i32;

@syscall("symlinkat")
pub fn symlinkat(target: str, newdirfd: i32, linkpath: str) i32;

@syscall("readlink")
pub fn readlink(path: str, buf: str, bufsiz: usize) isize;

@syscall("readlinkat")
pub fn readlinkat(dirfd: i32, path: str, buf: str, bufsiz: usize) isize;

@syscall("chmod")
pub fn chmod(path: str, mode: u32) i32;

@syscall("fchmod")
pub fn fchmod(fd: i32, mode: u32) i32;

@syscall("fchmodat")
pub fn fchmodat(dirfd: i32, path: str, mode: u32, flags: i32) i32;

@syscall("chown")
pub fn chown(path: str, owner: u32, group: u32) i32;

@syscall("fchown")
pub fn fchown(fd: i32, owner: u32, group: u32) i32;

@syscall("lchown")
pub fn lchown(path: str, owner: u32, group: u32) i32;

@syscall("fchownat")
pub fn fchownat(dirfd: i32, path: str, owner: u32, group: u32, flags: i32) i32;

@syscall("umask")
pub fn umask(mask: u32) u32;

// dirfd: AT_FDCWD=-100 to use cwd; flags: AT_ACCESS_*
@syscall("faccessat")
pub fn faccessat(dirfd: i32, path: str, mode: i32, flags: i32) i32;

@syscall("openat")
pub fn openat(dirfd: i32, path: str, flags: i32, mode: u32) i32;

// in/out: pointer to int (file descriptors); offset: pointer to off_t
@syscall("sendfile")
pub fn sendfile(out_fd: i32, in_fd: i32, offset: usize, count: usize) isize;

// preadv / pwritev — scatter-gather with offset
@syscall("preadv")
pub fn preadv(fd: i32, iov: usize, iovcnt: i32, offset: i64) isize;

@syscall("pwritev")
pub fn pwritev(fd: i32, iov: usize, iovcnt: i32, offset: i64) isize;

// statx — extended stat; mask controls which fields are filled
@syscall("statx")
pub fn statx(dirfd: i32, path: str, flags: i32, mask: u32, statxbuf: usize) i32;

// mknod — create special file (device, FIFO, socket)
@syscall("mknod")
pub fn mknod(path: str, mode: u32, dev: u64) i32;

// splice, tee, copy_file_range — zero-copy I/O
@syscall("splice")
pub fn splice(fd_in: i32, off_in: usize, fd_out: i32, off_out: usize, len: usize, flags: u32) isize;

@syscall("tee")
pub fn tee(fd_in: i32, fd_out: i32, len: usize, flags: u32) isize;

@syscall("copy_file_range")
pub fn copy_file_range(fd_in: i32, off_in: usize, fd_out: i32, off_out: usize, len: usize, flags: u32) isize;

// fallocate — preallocate file space
@syscall("fallocate")
pub fn fallocate(fd: i32, mode: i32, offset: i64, len: i64) i32;

// sync
@syscall("sync")
pub fn sync() void;

@syscall("syncfs")
pub fn syncfs(fd: i32) i32;

// ── Memory ───────────────────────────────────────────────────────────────────

// prot: PROT_NONE=0, PROT_READ=1, PROT_WRITE=2, PROT_EXEC=4
// flags: MAP_SHARED=1, MAP_PRIVATE=2, MAP_ANONYMOUS=32, MAP_FIXED=16
@syscall("mmap")
pub fn mmap(addr: usize, length: usize, prot: i32, flags: i32, fd: i32, offset: i64) usize;

@syscall("munmap")
pub fn munmap(addr: usize, length: usize) i32;

@syscall("mprotect")
pub fn mprotect(addr: usize, len: usize, prot: i32) i32;

// flags: MREMAP_MAYMOVE=1, MREMAP_FIXED=2
@syscall("mremap")
pub fn mremap(old_addr: usize, old_size: usize, new_size: usize, flags: i32, new_addr: usize) usize;

// advice: MADV_NORMAL=0, MADV_RANDOM=1, MADV_SEQUENTIAL=2, MADV_DONTNEED=4, MADV_FREE=8
@syscall("madvise")
pub fn madvise(addr: usize, length: usize, advice: i32) i32;

// flags: MS_ASYNC=1, MS_SYNC=4, MS_INVALIDATE=2
@syscall("msync")
pub fn msync(addr: usize, length: usize, flags: i32) i32;

@syscall("mlock")
pub fn mlock(addr: usize, len: usize) i32;

@syscall("munlock")
pub fn munlock(addr: usize, len: usize) i32;

// flags: MCL_CURRENT=1, MCL_FUTURE=2
@syscall("mlockall")
pub fn mlockall(flags: i32) i32;

@syscall("munlockall")
pub fn munlockall() i32;

@syscall("brk")
pub fn brk(addr: usize) usize;

// memfd_create — anonymous file in memory
@syscall("memfd_create")
pub fn memfd_create(name: str, flags: u32) i32;

// getrandom — kernel CSPRNG
@syscall("getrandom")
pub fn getrandom(buf: str, buflen: usize, flags: u32) isize;

// ── Process ──────────────────────────────────────────────────────────────────

@syscall("fork")
pub fn fork() i32;

@syscall("vfork")
pub fn vfork() i32;

// argv/envp: pointer to null-terminated array of C strings (usize)
@syscall("execve")
pub fn execve(path: str, argv: usize, envp: usize) i32;

@syscall("execveat")
pub fn execveat(dirfd: i32, path: str, argv: usize, envp: usize, flags: i32) i32;

// options: WNOHANG=1, WUNTRACED=2; usage: pointer to struct rusage or 0
@syscall("wait4")
pub fn wait4(pid: i32, wstatus: usize, options: i32, rusage: usize) i32;

// idtype: P_PID=1, P_PGID=2, P_ALL=0
@syscall("waitid")
pub fn waitid(idtype: i32, id: u32, infop: usize, options: i32) i32;

@syscall("exit")
pub fn exit(status: i32) void;

@syscall("exit_group")
pub fn exit_group(status: i32) void;

@syscall("getpid")
pub fn getpid() i32;

@syscall("getppid")
pub fn getppid() i32;

@syscall("gettid")
pub fn gettid() i32;

@syscall("setsid")
pub fn setsid() i32;

@syscall("getsid")
pub fn getsid(pid: i32) i32;

@syscall("setpgid")
pub fn setpgid(pid: i32, pgid: i32) i32;

@syscall("getpgid")
pub fn getpgid(pid: i32) i32;

@syscall("getpgrp")
pub fn getpgrp() i32;

// sig: SIGTERM=15, SIGKILL=9, SIGINT=2, SIGHUP=1, SIGUSR1=10, SIGUSR2=12
@syscall("kill")
pub fn kill(pid: i32, sig: i32) i32;

@syscall("tkill")
pub fn tkill(tid: i32, sig: i32) i32;

@syscall("tgkill")
pub fn tgkill(tgid: i32, tid: i32, sig: i32) i32;

// clone — low-level thread/process creation; flags control what's shared
@syscall("clone")
pub fn clone(flags: u64, stack: usize, parent_tid: usize, child_tid: usize, tls: usize) i32;

// prctl — process control
@syscall("prctl")
pub fn prctl(option: i32, arg2: usize, arg3: usize, arg4: usize, arg5: usize) i32;

// arch_prctl — x86-64 specific; op: ARCH_SET_FS=0x1002, ARCH_GET_FS=0x1003
@syscall("arch_prctl")
pub fn arch_prctl(op: i32, addr: usize) i32;

@syscall("sched_yield")
pub fn sched_yield() i32;

// sched_setaffinity / sched_getaffinity — CPU affinity mask
@syscall("sched_setaffinity")
pub fn sched_setaffinity(pid: i32, cpusetsize: usize, mask: usize) i32;

@syscall("sched_getaffinity")
pub fn sched_getaffinity(pid: i32, cpusetsize: usize, mask: usize) i32;

@syscall("getcpu")
pub fn getcpu(cpu: usize, node: usize) i32;

// ptrace — process tracing
@syscall("ptrace")
pub fn ptrace(request: i32, pid: i32, addr: usize, data: usize) isize;

@syscall("set_tid_address")
pub fn set_tid_address(tidptr: usize) i32;

// ── Signals ──────────────────────────────────────────────────────────────────

// signum: signal number; act: pointer to struct sigaction; oldact: pointer or 0
@syscall("rt_sigaction")
pub fn rt_sigaction(signum: i32, act: usize, oldact: usize, sigsetsize: usize) i32;

// how: SIG_BLOCK=0, SIG_UNBLOCK=1, SIG_SETMASK=2
@syscall("rt_sigprocmask")
pub fn rt_sigprocmask(how: i32, set: usize, oldset: usize, sigsetsize: usize) i32;

@syscall("rt_sigpending")
pub fn rt_sigpending(set: usize, sigsetsize: usize) i32;

@syscall("rt_sigsuspend")
pub fn rt_sigsuspend(mask: usize, sigsetsize: usize) i32;

@syscall("pause")
pub fn pause() i32;

@syscall("alarm")
pub fn alarm(seconds: u32) u32;

// sigaltstack — set/get alternate signal stack
@syscall("sigaltstack")
pub fn sigaltstack(ss: usize, old_ss: usize) i32;

// ── Time ─────────────────────────────────────────────────────────────────────

// tv: pointer to struct timeval { i64 sec, i64 usec }; tz: pointer to struct timezone or 0
@syscall("gettimeofday")
pub fn gettimeofday(tv: usize, tz: usize) i32;

@syscall("settimeofday")
pub fn settimeofday(tv: usize, tz: usize) i32;

// req/rem: pointer to struct timespec { i64 sec, i64 nsec }
@syscall("nanosleep")
pub fn nanosleep(req: usize, rem: usize) i32;

// clockid: CLOCK_REALTIME=0, CLOCK_MONOTONIC=1, CLOCK_PROCESS_CPUTIME_ID=2
@syscall("clock_gettime")
pub fn clock_gettime(clockid: i32, tp: usize) i32;

@syscall("clock_settime")
pub fn clock_settime(clockid: i32, tp: usize) i32;

@syscall("clock_getres")
pub fn clock_getres(clockid: i32, res: usize) i32;

@syscall("clock_nanosleep")
pub fn clock_nanosleep(clockid: i32, flags: i32, req: usize, rem: usize) i32;

@syscall("getitimer")
pub fn getitimer(which: i32, curr_value: usize) i32;

@syscall("setitimer")
pub fn setitimer(which: i32, new_value: usize, old_value: usize) i32;

@syscall("times")
pub fn times(buf: usize) isize;

@syscall("time")
pub fn time(tloc: usize) i64;

// ── Networking ───────────────────────────────────────────────────────────────

// domain: AF_UNIX=1, AF_INET=2, AF_INET6=10
// type: SOCK_STREAM=1, SOCK_DGRAM=2, SOCK_RAW=3, SOCK_NONBLOCK=2048, SOCK_CLOEXEC=524288
@syscall("socket")
pub fn socket(domain: i32, stype: i32, protocol: i32) i32;

// addr: pointer to sockaddr variant; addrlen: sizeof(sockaddr_*)
@syscall("bind")
pub fn bind(sockfd: i32, addr: usize, addrlen: u32) i32;

@syscall("listen")
pub fn listen(sockfd: i32, backlog: i32) i32;

@syscall("accept")
pub fn accept(sockfd: i32, addr: usize, addrlen: usize) i32;

@syscall("accept4")
pub fn accept4(sockfd: i32, addr: usize, addrlen: usize, flags: i32) i32;

@syscall("connect")
pub fn connect(sockfd: i32, addr: usize, addrlen: u32) i32;

@syscall("sendto")
pub fn sendto(sockfd: i32, buf: str, len: usize, flags: i32, dest_addr: usize, addrlen: u32) isize;

@syscall("recvfrom")
pub fn recvfrom(sockfd: i32, buf: str, len: usize, flags: i32, src_addr: usize, addrlen: usize) isize;

// msghdr: pointer to struct msghdr
@syscall("sendmsg")
pub fn sendmsg(sockfd: i32, msg: usize, flags: i32) isize;

@syscall("recvmsg")
pub fn recvmsg(sockfd: i32, msg: usize, flags: i32) isize;

// how: SHUT_RD=0, SHUT_WR=1, SHUT_RDWR=2
@syscall("shutdown")
pub fn shutdown(sockfd: i32, how: i32) i32;

@syscall("getsockname")
pub fn getsockname(sockfd: i32, addr: usize, addrlen: usize) i32;

@syscall("getpeername")
pub fn getpeername(sockfd: i32, addr: usize, addrlen: usize) i32;

@syscall("socketpair")
pub fn socketpair(domain: i32, stype: i32, protocol: i32, sv: usize) i32;

@syscall("setsockopt")
pub fn setsockopt(sockfd: i32, level: i32, optname: i32, optval: usize, optlen: u32) i32;

@syscall("getsockopt")
pub fn getsockopt(sockfd: i32, level: i32, optname: i32, optval: usize, optlen: usize) i32;

// ── Async I/O & event notification ───────────────────────────────────────────

// epoll
@syscall("epoll_create1")
pub fn epoll_create1(flags: i32) i32;

// op: EPOLL_CTL_ADD=1, EPOLL_CTL_DEL=2, EPOLL_CTL_MOD=3; event: pointer to struct epoll_event
@syscall("epoll_ctl")
pub fn epoll_ctl(epfd: i32, op: i32, fd: i32, event: usize) i32;

// events: pointer to struct epoll_event[]; maxevents: capacity; timeout: ms
@syscall("epoll_wait")
pub fn epoll_wait(epfd: i32, events: usize, maxevents: i32, timeout: i32) i32;

@syscall("epoll_pwait")
pub fn epoll_pwait(epfd: i32, events: usize, maxevents: i32, timeout: i32, sigmask: usize) i32;

// eventfd
@syscall("eventfd2")
pub fn eventfd2(initval: u32, flags: i32) i32;

// timerfd
// clockid: CLOCK_REALTIME=0, CLOCK_MONOTONIC=1
@syscall("timerfd_create")
pub fn timerfd_create(clockid: i32, flags: i32) i32;

// new_value/old_value: pointer to struct itimerspec
@syscall("timerfd_settime")
pub fn timerfd_settime(fd: i32, flags: i32, new_value: usize, old_value: usize) i32;

@syscall("timerfd_gettime")
pub fn timerfd_gettime(fd: i32, curr_value: usize) i32;

// inotify
@syscall("inotify_init1")
pub fn inotify_init1(flags: i32) i32;

@syscall("inotify_add_watch")
pub fn inotify_add_watch(fd: i32, path: str, mask: u32) i32;

@syscall("inotify_rm_watch")
pub fn inotify_rm_watch(fd: i32, wd: i32) i32;

// signalfd
@syscall("signalfd4")
pub fn signalfd4(fd: i32, mask: usize, sizemask: usize, flags: i32) i32;

// futex — building block for mutexes and condition variables
// op: FUTEX_WAIT=0, FUTEX_WAKE=1, FUTEX_FD=2, FUTEX_REQUEUE=3
@syscall("futex")
pub fn futex(uaddr: usize, op: i32, val: u32, timeout: usize, uaddr2: usize, val3: u32) i32;

// ── User / Group ─────────────────────────────────────────────────────────────

@syscall("getuid")
pub fn getuid() u32;

@syscall("getgid")
pub fn getgid() u32;

@syscall("geteuid")
pub fn geteuid() u32;

@syscall("getegid")
pub fn getegid() u32;

@syscall("setuid")
pub fn setuid(uid: u32) i32;

@syscall("setgid")
pub fn setgid(gid: u32) i32;

@syscall("setreuid")
pub fn setreuid(ruid: u32, euid: u32) i32;

@syscall("setregid")
pub fn setregid(rgid: u32, egid: u32) i32;

@syscall("setresuid")
pub fn setresuid(ruid: u32, euid: u32, suid: u32) i32;

@syscall("getresuid")
pub fn getresuid(ruid: usize, euid: usize, suid: usize) i32;

@syscall("setresgid")
pub fn setresgid(rgid: u32, egid: u32, sgid: u32) i32;

@syscall("getresgid")
pub fn getresgid(rgid: usize, egid: usize, sgid: usize) i32;

// list: pointer to gid_t[]; size: capacity
@syscall("getgroups")
pub fn getgroups(size: i32, list: usize) i32;

@syscall("setgroups")
pub fn setgroups(size: usize, list: usize) i32;

@syscall("setfsuid")
pub fn setfsuid(fsuid: u32) i32;

@syscall("setfsgid")
pub fn setfsgid(fsgid: u32) i32;

// ── System info ──────────────────────────────────────────────────────────────

// buf: pointer to struct utsname
@syscall("uname")
pub fn uname(buf: usize) i32;

// info: pointer to struct sysinfo
@syscall("sysinfo")
pub fn sysinfo(info: usize) i32;

// who: RUSAGE_SELF=0, RUSAGE_CHILDREN=-1; usage: pointer to struct rusage
@syscall("getrusage")
pub fn getrusage(who: i32, usage: usize) i32;

// resource: RLIMIT_NOFILE=7, RLIMIT_STACK=3, RLIMIT_AS=9; rlim: pointer to struct rlimit
@syscall("getrlimit")
pub fn getrlimit(resource: i32, rlim: usize) i32;

@syscall("setrlimit")
pub fn setrlimit(resource: i32, rlim: usize) i32;

// pid=0 means self; new_limit: pointer to struct rlimit64
@syscall("prlimit64")
pub fn prlimit64(pid: i32, resource: i32, new_limit: usize, old_limit: usize) i32;

@syscall("syslog")
pub fn syslog(stype: i32, buf: str, len: i32) i32;

// hostname
@syscall("sethostname")
pub fn sethostname(name: str, len: usize) i32;

@syscall("setdomainname")
pub fn setdomainname(name: str, len: usize) i32;

