// std.unix — raw Linux x86-64 syscall bindings
// Every function maps 1:1 to a Linux syscall via @syscall.
// Not available on Windows (@syscall emits a no-op there).
// All functions are implicitly unsafe — callers must wrap in unsafe {}.
//
// Pointer conventions:
//   *u8   — opaque byte pointer (struct*, void*)
//   *u32  — pointer to u32 out-parameter
//   *i32  — pointer to i32 out-parameter
//   *i64  — pointer to i64 / off_t out-parameter
//   str   — pointer to byte buffer or C string (read-only view)
//
// Other type conventions:
//   fd:    i32   — file descriptor
//   path:  str   — pointer to null-terminated C string
//   count: usize — byte count / size_t
//   isize       — ssize_t / signed return
//   usize       — pointer-sized integer (non-pointer polymorphic values)
//   u32         — unsigned int (mode_t, uid_t, gid_t)
//   i64         — off_t, time_t

// ── File I/O ─────────────────────────────────────────────────────────────────

@syscall("read")
pub fn read(fd: i32, buf: str, count: usize) isize;

@syscall("write")
pub fn write(fd: i32, buf: str, count: usize) isize;

// flags: O_RDONLY=0, O_WRONLY=1, O_RDWR=2, O_CREAT=64, O_TRUNC=512, O_APPEND=1024
@syscall("open")
pub fn open(path: str, flags: i32, mode: u32) i32;

@syscall("close")
pub fn close(fd: i32) i32;

// statbuf: pointer to struct stat (144 bytes on x86-64)
@syscall("stat")
pub unsafe fn stat(path: str, statbuf: *u8) i32;

@syscall("fstat")
pub unsafe fn fstat(fd: i32, statbuf: *u8) i32;

@syscall("lstat")
pub unsafe fn lstat(path: str, statbuf: *u8) i32;

// fds: pointer to struct pollfd[]; nfds: count; timeout: ms (-1 = forever)
@syscall("poll")
pub unsafe fn poll(fds: *u8, nfds: usize, timeout: i32) i32;

// whence: SEEK_SET=0, SEEK_CUR=1, SEEK_END=2
@syscall("lseek")
pub fn lseek(fd: i32, offset: i64, whence: i32) i64;

// pread64 / pwrite64 — positional read/write (no seek side effect)
@syscall("pread64")
pub fn pread64(fd: i32, buf: str, count: usize, offset: i64) isize;

@syscall("pwrite64")
pub fn pwrite64(fd: i32, buf: str, count: usize, offset: i64) isize;

// iov: pointer to struct iovec[]; iovcnt: vector count
@syscall("readv")
pub unsafe fn readv(fd: i32, iov: *u8, iovcnt: i32) isize;

@syscall("writev")
pub unsafe fn writev(fd: i32, iov: *u8, iovcnt: i32) isize;

// mode: R_OK=4, W_OK=2, X_OK=1, F_OK=0
@syscall("access")
pub fn access(path: str, mode: i32) i32;

// pipe — pipefd: pointer to i32[2]; [0]=read end, [1]=write end
@syscall("pipe")
pub unsafe fn pipe(pipefd: *u8) i32;

@syscall("pipe2")
pub unsafe fn pipe2(pipefd: *u8, flags: i32) i32;

// readfds/writefds/exceptfds: pointer to fd_set; timeout: pointer to struct timeval
@syscall("select")
pub unsafe fn select(nfds: i32, readfds: *u8, writefds: *u8, exceptfds: *u8, timeout: *u8) i32;

@syscall("dup")
pub fn dup(oldfd: i32) i32;

@syscall("dup2")
pub fn dup2(oldfd: i32, newfd: i32) i32;

@syscall("dup3")
pub fn dup3(oldfd: i32, newfd: i32, flags: i32) i32;

// request/arg are polymorphic per ioctl — keep as usize
@syscall("ioctl")
pub fn ioctl(fd: i32, request: usize, arg: usize) i32;

// cmd: F_DUPFD=0, F_GETFD=1, F_SETFD=2, F_GETFL=3, F_SETFL=4
@syscall("fcntl")
pub fn fcntl(fd: i32, cmd: i32, arg: i64) i32;

// operation: LOCK_SH=1, LOCK_EX=2, LOCK_NB=4, LOCK_UN=8
@syscall("flock")
pub fn flock(fd: i32, operation: i32) i32;

@syscall("fsync")
pub fn fsync(fd: i32) i32;

@syscall("fdatasync")
pub fn fdatasync(fd: i32) i32;

@syscall("truncate")
pub fn truncate(path: str, length: i64) i32;

@syscall("ftruncate")
pub fn ftruncate(fd: i32, length: i64) i32;

// dirp: pointer to struct dirent buffer; count: buffer size
@syscall("getdents")
pub unsafe fn getdents(fd: i32, dirp: *u8, count: usize) isize;

@syscall("getdents64")
pub unsafe fn getdents64(fd: i32, dirp: *u8, count: usize) isize;

@syscall("getcwd")
pub fn getcwd(buf: str, size: usize) isize;

@syscall("chdir")
pub fn chdir(path: str) i32;

@syscall("fchdir")
pub fn fchdir(fd: i32) i32;

@syscall("rename")
pub fn rename(oldpath: str, newpath: str) i32;

@syscall("renameat")
pub fn renameat(olddirfd: i32, oldpath: str, newdirfd: i32, newpath: str) i32;

@syscall("mkdir")
pub fn mkdir(path: str, mode: u32) i32;

@syscall("mkdirat")
pub fn mkdirat(dirfd: i32, path: str, mode: u32) i32;

@syscall("rmdir")
pub fn rmdir(path: str) i32;

@syscall("creat")
pub fn creat(path: str, mode: u32) i32;

@syscall("link")
pub fn link(oldpath: str, newpath: str) i32;

@syscall("linkat")
pub fn linkat(olddirfd: i32, oldpath: str, newdirfd: i32, newpath: str, flags: i32) i32;

@syscall("unlink")
pub fn unlink(path: str) i32;

@syscall("unlinkat")
pub fn unlinkat(dirfd: i32, path: str, flags: i32) i32;

@syscall("symlink")
pub fn symlink(target: str, linkpath: str) i32;

@syscall("symlinkat")
pub fn symlinkat(target: str, newdirfd: i32, linkpath: str) i32;

@syscall("readlink")
pub fn readlink(path: str, buf: str, bufsiz: usize) isize;

@syscall("readlinkat")
pub fn readlinkat(dirfd: i32, path: str, buf: str, bufsiz: usize) isize;

@syscall("chmod")
pub fn chmod(path: str, mode: u32) i32;

@syscall("fchmod")
pub fn fchmod(fd: i32, mode: u32) i32;

@syscall("fchmodat")
pub fn fchmodat(dirfd: i32, path: str, mode: u32, flags: i32) i32;

@syscall("chown")
pub fn chown(path: str, owner: u32, group: u32) i32;

@syscall("fchown")
pub fn fchown(fd: i32, owner: u32, group: u32) i32;

@syscall("lchown")
pub fn lchown(path: str, owner: u32, group: u32) i32;

@syscall("fchownat")
pub fn fchownat(dirfd: i32, path: str, owner: u32, group: u32, flags: i32) i32;

@syscall("umask")
pub fn umask(mask: u32) u32;

// dirfd: AT_FDCWD=-100 to use cwd
@syscall("faccessat")
pub fn faccessat(dirfd: i32, path: str, mode: i32, flags: i32) i32;

@syscall("openat")
pub fn openat(dirfd: i32, path: str, flags: i32, mode: u32) i32;

// offset: pointer to off_t (i64) — updated with new file position; pass null to ignore
@syscall("sendfile")
pub unsafe fn sendfile(out_fd: i32, in_fd: i32, offset: *i64, count: usize) isize;

// iov: pointer to struct iovec[]
@syscall("preadv")
pub unsafe fn preadv(fd: i32, iov: *u8, iovcnt: i32, offset: i64) isize;

@syscall("pwritev")
pub unsafe fn pwritev(fd: i32, iov: *u8, iovcnt: i32, offset: i64) isize;

// statxbuf: pointer to struct statx
@syscall("statx")
pub unsafe fn statx(dirfd: i32, path: str, flags: i32, mask: u32, statxbuf: *u8) i32;

// mknod — create special file (device, FIFO, socket)
@syscall("mknod")
pub fn mknod(path: str, mode: u32, dev: u64) i32;

// off_in / off_out: pointer to off_t (updated after call); pass null to use fd position
@syscall("splice")
pub unsafe fn splice(fd_in: i32, off_in: *i64, fd_out: i32, off_out: *i64, len: usize, flags: u32) isize;

@syscall("tee")
pub fn tee(fd_in: i32, fd_out: i32, len: usize, flags: u32) isize;

@syscall("copy_file_range")
pub unsafe fn copy_file_range(fd_in: i32, off_in: *i64, fd_out: i32, off_out: *i64, len: usize, flags: u32) isize;

// fallocate — preallocate file space
@syscall("fallocate")
pub fn fallocate(fd: i32, mode: i32, offset: i64, len: i64) i32;

@syscall("sync")
pub fn sync() void;

@syscall("syncfs")
pub fn syncfs(fd: i32) i32;

// ── Memory ───────────────────────────────────────────────────────────────────

// prot: PROT_NONE=0, PROT_READ=1, PROT_WRITE=2, PROT_EXEC=4
// flags: MAP_SHARED=1, MAP_PRIVATE=2, MAP_ANONYMOUS=32, MAP_FIXED=16
// addr: hint address (pass null for kernel choice); returns mapped address or MAP_FAILED
@syscall("mmap")
pub unsafe fn mmap(addr: *u8, length: usize, prot: i32, flags: i32, fd: i32, offset: i64) *u8;

@syscall("munmap")
pub unsafe fn munmap(addr: *u8, length: usize) i32;

@syscall("mprotect")
pub unsafe fn mprotect(addr: *u8, len: usize, prot: i32) i32;

// flags: MREMAP_MAYMOVE=1, MREMAP_FIXED=2
// new_addr: only used when MREMAP_FIXED is set
@syscall("mremap")
pub unsafe fn mremap(old_addr: *u8, old_size: usize, new_size: usize, flags: i32, new_addr: *u8) *u8;

// advice: MADV_NORMAL=0, MADV_RANDOM=1, MADV_SEQUENTIAL=2, MADV_DONTNEED=4, MADV_FREE=8
@syscall("madvise")
pub unsafe fn madvise(addr: *u8, length: usize, advice: i32) i32;

// flags: MS_ASYNC=1, MS_SYNC=4, MS_INVALIDATE=2
@syscall("msync")
pub unsafe fn msync(addr: *u8, length: usize, flags: i32) i32;

@syscall("mlock")
pub unsafe fn mlock(addr: *u8, len: usize) i32;

@syscall("munlock")
pub unsafe fn munlock(addr: *u8, len: usize) i32;

// flags: MCL_CURRENT=1, MCL_FUTURE=2
@syscall("mlockall")
pub fn mlockall(flags: i32) i32;

@syscall("munlockall")
pub fn munlockall() i32;

// brk — set program break (end of data segment); returns new break
@syscall("brk")
pub unsafe fn brk(addr: *u8) *u8;

// memfd_create — anonymous file in memory
@syscall("memfd_create")
pub fn memfd_create(name: str, flags: u32) i32;

// getrandom — kernel CSPRNG; buf is a write buffer
@syscall("getrandom")
pub fn getrandom(buf: str, buflen: usize, flags: u32) isize;

// ── Process ──────────────────────────────────────────────────────────────────

@syscall("fork")
pub fn fork() i32;

@syscall("vfork")
pub fn vfork() i32;

// argv/envp: pointer to null-terminated array of C strings
@syscall("execve")
pub unsafe fn execve(path: str, argv: *u8, envp: *u8) i32;

@syscall("execveat")
pub unsafe fn execveat(dirfd: i32, path: str, argv: *u8, envp: *u8, flags: i32) i32;

// wstatus: pointer to i32 exit status; rusage: pointer to struct rusage or null
@syscall("wait4")
pub unsafe fn wait4(pid: i32, wstatus: *u32, options: i32, rusage: *u8) i32;

// infop: pointer to siginfo_t
@syscall("waitid")
pub unsafe fn waitid(idtype: i32, id: u32, infop: *u8, options: i32) i32;

@syscall("exit")
pub fn exit(status: i32) void;

@syscall("exit_group")
pub fn exit_group(status: i32) void;

@syscall("getpid")
pub fn getpid() i32;

@syscall("getppid")
pub fn getppid() i32;

@syscall("gettid")
pub fn gettid() i32;

@syscall("setsid")
pub fn setsid() i32;

@syscall("getsid")
pub fn getsid(pid: i32) i32;

@syscall("setpgid")
pub fn setpgid(pid: i32, pgid: i32) i32;

@syscall("getpgid")
pub fn getpgid(pid: i32) i32;

@syscall("getpgrp")
pub fn getpgrp() i32;

// sig: SIGTERM=15, SIGKILL=9, SIGINT=2, SIGHUP=1, SIGUSR1=10, SIGUSR2=12
@syscall("kill")
pub fn kill(pid: i32, sig: i32) i32;

@syscall("tkill")
pub fn tkill(tid: i32, sig: i32) i32;

@syscall("tgkill")
pub fn tgkill(tgid: i32, tid: i32, sig: i32) i32;

// clone — low-level thread/process creation
// stack: top of new stack; parent_tid/child_tid: pointers to TID storage; tls: TLS base
@syscall("clone")
pub unsafe fn clone(flags: u64, stack: *u8, parent_tid: *u32, child_tid: *u32, tls: *u8) i32;

// prctl — args are polymorphic (int or pointer per option); keep as usize
@syscall("prctl")
pub fn prctl(option: i32, arg2: usize, arg3: usize, arg4: usize, arg5: usize) i32;

// arch_prctl — x86-64 specific; op: ARCH_SET_FS=0x1002, ARCH_GET_FS=0x1003
// addr: pointer to u64 for GET, value for SET
@syscall("arch_prctl")
pub unsafe fn arch_prctl(op: i32, addr: *u8) i32;

@syscall("sched_yield")
pub fn sched_yield() i32;

// mask: pointer to cpu_set_t
@syscall("sched_setaffinity")
pub unsafe fn sched_setaffinity(pid: i32, cpusetsize: usize, mask: *u8) i32;

@syscall("sched_getaffinity")
pub unsafe fn sched_getaffinity(pid: i32, cpusetsize: usize, mask: *u8) i32;

// cpu/node: pointers to u32 out-parameters
@syscall("getcpu")
pub unsafe fn getcpu(cpu: *u32, node: *u32) i32;

// ptrace — addr/data are polymorphic per request
@syscall("ptrace")
pub unsafe fn ptrace(request: i32, pid: i32, addr: *u8, data: *u8) isize;

// tidptr: pointer to u32 (cleared on thread exit, triggers futex wake)
@syscall("set_tid_address")
pub unsafe fn set_tid_address(tidptr: *u32) i32;

// ── Signals ──────────────────────────────────────────────────────────────────

// act/oldact: pointer to struct sigaction (or null)
@syscall("rt_sigaction")
pub unsafe fn rt_sigaction(signum: i32, act: *u8, oldact: *u8, sigsetsize: usize) i32;

// set/oldset: pointer to sigset_t (or null)
// how: SIG_BLOCK=0, SIG_UNBLOCK=1, SIG_SETMASK=2
@syscall("rt_sigprocmask")
pub unsafe fn rt_sigprocmask(how: i32, set: *u8, oldset: *u8, sigsetsize: usize) i32;

// set: pointer to sigset_t output
@syscall("rt_sigpending")
pub unsafe fn rt_sigpending(set: *u8, sigsetsize: usize) i32;

// mask: pointer to sigset_t to block while waiting
@syscall("rt_sigsuspend")
pub unsafe fn rt_sigsuspend(mask: *u8, sigsetsize: usize) i32;

@syscall("pause")
pub fn pause() i32;

@syscall("alarm")
pub fn alarm(seconds: u32) u32;

// ss/old_ss: pointer to stack_t struct (or null)
@syscall("sigaltstack")
pub unsafe fn sigaltstack(ss: *u8, old_ss: *u8) i32;

// ── Time ─────────────────────────────────────────────────────────────────────

// tv: pointer to struct timeval { i64 sec, i64 usec }; tz: pointer to struct timezone or null
@syscall("gettimeofday")
pub unsafe fn gettimeofday(tv: *u8, tz: *u8) i32;

@syscall("settimeofday")
pub unsafe fn settimeofday(tv: *u8, tz: *u8) i32;

// req/rem: pointer to struct timespec { i64 sec, i64 nsec }
@syscall("nanosleep")
pub unsafe fn nanosleep(req: *u8, rem: *u8) i32;

// clockid: CLOCK_REALTIME=0, CLOCK_MONOTONIC=1, CLOCK_PROCESS_CPUTIME_ID=2
// tp: pointer to struct timespec output
@syscall("clock_gettime")
pub unsafe fn clock_gettime(clockid: i32, tp: *u8) i32;

@syscall("clock_settime")
pub unsafe fn clock_settime(clockid: i32, tp: *u8) i32;

// res: pointer to struct timespec output
@syscall("clock_getres")
pub unsafe fn clock_getres(clockid: i32, res: *u8) i32;

@syscall("clock_nanosleep")
pub unsafe fn clock_nanosleep(clockid: i32, flags: i32, req: *u8, rem: *u8) i32;

// curr_value: pointer to struct itimerval output
@syscall("getitimer")
pub unsafe fn getitimer(which: i32, curr_value: *u8) i32;

// new_value/old_value: pointer to struct itimerval
@syscall("setitimer")
pub unsafe fn setitimer(which: i32, new_value: *u8, old_value: *u8) i32;

// buf: pointer to struct tms output
@syscall("times")
pub unsafe fn times(buf: *u8) isize;

// tloc: pointer to time_t output (or null); returns seconds since epoch
@syscall("time")
pub unsafe fn time(tloc: *i64) i64;

// ── Networking ───────────────────────────────────────────────────────────────

// domain: AF_UNIX=1, AF_INET=2, AF_INET6=10
// type: SOCK_STREAM=1, SOCK_DGRAM=2, SOCK_RAW=3
@syscall("socket")
pub fn socket(domain: i32, stype: i32, protocol: i32) i32;

// addr: pointer to sockaddr variant; addrlen: sizeof(sockaddr_*)
@syscall("bind")
pub unsafe fn bind(sockfd: i32, addr: *u8, addrlen: u32) i32;

@syscall("listen")
pub fn listen(sockfd: i32, backlog: i32) i32;

// addr: pointer to sockaddr output; addrlen: pointer to socklen_t (in/out)
@syscall("accept")
pub unsafe fn accept(sockfd: i32, addr: *u8, addrlen: *u32) i32;

@syscall("accept4")
pub unsafe fn accept4(sockfd: i32, addr: *u8, addrlen: *u32, flags: i32) i32;

@syscall("connect")
pub unsafe fn connect(sockfd: i32, addr: *u8, addrlen: u32) i32;

@syscall("sendto")
pub unsafe fn sendto(sockfd: i32, buf: str, len: usize, flags: i32, dest_addr: *u8, addrlen: u32) isize;

// src_addr: pointer to sockaddr output; addrlen: pointer to socklen_t (in/out)
@syscall("recvfrom")
pub unsafe fn recvfrom(sockfd: i32, buf: str, len: usize, flags: i32, src_addr: *u8, addrlen: *u32) isize;

// msg: pointer to struct msghdr
@syscall("sendmsg")
pub unsafe fn sendmsg(sockfd: i32, msg: *u8, flags: i32) isize;

@syscall("recvmsg")
pub unsafe fn recvmsg(sockfd: i32, msg: *u8, flags: i32) isize;

// how: SHUT_RD=0, SHUT_WR=1, SHUT_RDWR=2
@syscall("shutdown")
pub fn shutdown(sockfd: i32, how: i32) i32;

// addr: pointer to sockaddr output; addrlen: pointer to socklen_t (in/out)
@syscall("getsockname")
pub unsafe fn getsockname(sockfd: i32, addr: *u8, addrlen: *u32) i32;

@syscall("getpeername")
pub unsafe fn getpeername(sockfd: i32, addr: *u8, addrlen: *u32) i32;

// sv: pointer to i32[2] (two connected sockets)
@syscall("socketpair")
pub unsafe fn socketpair(domain: i32, stype: i32, protocol: i32, sv: *u8) i32;

// optval: pointer to option value buffer; optlen: size of buffer
@syscall("setsockopt")
pub unsafe fn setsockopt(sockfd: i32, level: i32, optname: i32, optval: *u8, optlen: u32) i32;

// optval: pointer to option value output; optlen: pointer to socklen_t (in/out)
@syscall("getsockopt")
pub unsafe fn getsockopt(sockfd: i32, level: i32, optname: i32, optval: *u8, optlen: *u32) i32;

// ── Async I/O & event notification ───────────────────────────────────────────

@syscall("epoll_create1")
pub fn epoll_create1(flags: i32) i32;

// op: EPOLL_CTL_ADD=1, EPOLL_CTL_DEL=2, EPOLL_CTL_MOD=3; event: pointer to struct epoll_event
@syscall("epoll_ctl")
pub unsafe fn epoll_ctl(epfd: i32, op: i32, fd: i32, event: *u8) i32;

// events: pointer to struct epoll_event[maxevents]
@syscall("epoll_wait")
pub unsafe fn epoll_wait(epfd: i32, events: *u8, maxevents: i32, timeout: i32) i32;

// sigmask: pointer to sigset_t (or null)
@syscall("epoll_pwait")
pub unsafe fn epoll_pwait(epfd: i32, events: *u8, maxevents: i32, timeout: i32, sigmask: *u8) i32;

@syscall("eventfd2")
pub fn eventfd2(initval: u32, flags: i32) i32;

// clockid: CLOCK_REALTIME=0, CLOCK_MONOTONIC=1
@syscall("timerfd_create")
pub fn timerfd_create(clockid: i32, flags: i32) i32;

// new_value/old_value: pointer to struct itimerspec
@syscall("timerfd_settime")
pub unsafe fn timerfd_settime(fd: i32, flags: i32, new_value: *u8, old_value: *u8) i32;

// curr_value: pointer to struct itimerspec output
@syscall("timerfd_gettime")
pub unsafe fn timerfd_gettime(fd: i32, curr_value: *u8) i32;

@syscall("inotify_init1")
pub fn inotify_init1(flags: i32) i32;

@syscall("inotify_add_watch")
pub fn inotify_add_watch(fd: i32, path: str, mask: u32) i32;

@syscall("inotify_rm_watch")
pub fn inotify_rm_watch(fd: i32, wd: i32) i32;

// mask: pointer to sigset_t
@syscall("signalfd4")
pub unsafe fn signalfd4(fd: i32, mask: *u8, sizemask: usize, flags: i32) i32;

// uaddr/uaddr2: pointer to u32 futex word; timeout: pointer to struct timespec or null
// op: FUTEX_WAIT=0, FUTEX_WAKE=1, FUTEX_FD=2, FUTEX_REQUEUE=3
@syscall("futex")
pub unsafe fn futex(uaddr: *u32, op: i32, val: u32, timeout: *u8, uaddr2: *u32, val3: u32) i32;

// ── User / Group ─────────────────────────────────────────────────────────────

@syscall("getuid")
pub fn getuid() u32;

@syscall("getgid")
pub fn getgid() u32;

@syscall("geteuid")
pub fn geteuid() u32;

@syscall("getegid")
pub fn getegid() u32;

@syscall("setuid")
pub fn setuid(uid: u32) i32;

@syscall("setgid")
pub fn setgid(gid: u32) i32;

@syscall("setreuid")
pub fn setreuid(ruid: u32, euid: u32) i32;

@syscall("setregid")
pub fn setregid(rgid: u32, egid: u32) i32;

@syscall("setresuid")
pub fn setresuid(ruid: u32, euid: u32, suid: u32) i32;

// ruid/euid/suid: pointers to u32 output
@syscall("getresuid")
pub unsafe fn getresuid(ruid: *u32, euid: *u32, suid: *u32) i32;

@syscall("setresgid")
pub fn setresgid(rgid: u32, egid: u32, sgid: u32) i32;

// rgid/egid/sgid: pointers to u32 output
@syscall("getresgid")
pub unsafe fn getresgid(rgid: *u32, egid: *u32, sgid: *u32) i32;

// list: pointer to gid_t[] output; size: capacity
@syscall("getgroups")
pub unsafe fn getgroups(size: i32, list: *u32) i32;

// list: pointer to gid_t[] input
@syscall("setgroups")
pub unsafe fn setgroups(size: usize, list: *u32) i32;

@syscall("setfsuid")
pub fn setfsuid(fsuid: u32) i32;

@syscall("setfsgid")
pub fn setfsgid(fsgid: u32) i32;

// ── System info ──────────────────────────────────────────────────────────────

// buf: pointer to struct utsname output
@syscall("uname")
pub unsafe fn uname(buf: *u8) i32;

// info: pointer to struct sysinfo output
@syscall("sysinfo")
pub unsafe fn sysinfo(info: *u8) i32;

// who: RUSAGE_SELF=0, RUSAGE_CHILDREN=-1; usage: pointer to struct rusage output
@syscall("getrusage")
pub unsafe fn getrusage(who: i32, usage: *u8) i32;

// resource: RLIMIT_NOFILE=7, RLIMIT_STACK=3, RLIMIT_AS=9; rlim: pointer to struct rlimit
@syscall("getrlimit")
pub unsafe fn getrlimit(resource: i32, rlim: *u8) i32;

@syscall("setrlimit")
pub unsafe fn setrlimit(resource: i32, rlim: *u8) i32;

// new_limit/old_limit: pointer to struct rlimit64 (or null)
@syscall("prlimit64")
pub unsafe fn prlimit64(pid: i32, resource: i32, new_limit: *u8, old_limit: *u8) i32;

@syscall("syslog")
pub fn syslog(stype: i32, buf: str, len: i32) i32;

@syscall("sethostname")
pub fn sethostname(name: str, len: usize) i32;

@syscall("setdomainname")
pub fn setdomainname(name: str, len: usize) i32;

// arg: optional pointer (depends on cmd); pass null if unused
@syscall("reboot")
pub unsafe fn reboot(magic1: i32, magic2: i32, cmd: u32, arg: *u8) i32;

@syscall("chroot")
pub fn chroot(path: str) i32;

// data: filesystem-specific mount options pointer (or null)
@syscall("mount")
pub unsafe fn mount(source: str, target: str, fstype: str, mountflags: usize, data: *u8) i32;

@syscall("umount2")
pub fn umount2(target: str, flags: i32) i32;

@syscall("swapon")
pub fn swapon(path: str, swapflags: i32) i32;

@syscall("swapoff")
pub fn swapoff(path: str) i32;

@syscall("acct")
pub fn acct(filename: str) i32;

// ── Extended attributes ───────────────────────────────────────────────────────

// value: pointer to attribute value buffer
@syscall("setxattr")
pub unsafe fn setxattr(path: str, name: str, value: *u8, size: usize, flags: i32) i32;

@syscall("lsetxattr")
pub unsafe fn lsetxattr(path: str, name: str, value: *u8, size: usize, flags: i32) i32;

@syscall("fsetxattr")
pub unsafe fn fsetxattr(fd: i32, name: str, value: *u8, size: usize, flags: i32) i32;

// value: pointer to output buffer for attribute value
@syscall("getxattr")
pub unsafe fn getxattr(path: str, name: str, value: *u8, size: usize) isize;

@syscall("lgetxattr")
pub unsafe fn lgetxattr(path: str, name: str, value: *u8, size: usize) isize;

@syscall("fgetxattr")
pub unsafe fn fgetxattr(fd: i32, name: str, value: *u8, size: usize) isize;

@syscall("listxattr")
pub fn listxattr(path: str, list: str, size: usize) isize;

@syscall("llistxattr")
pub fn llistxattr(path: str, list: str, size: usize) isize;

@syscall("flistxattr")
pub fn flistxattr(fd: i32, list: str, size: usize) isize;

@syscall("removexattr")
pub fn removexattr(path: str, name: str) i32;

@syscall("lremovexattr")
pub fn lremovexattr(path: str, name: str) i32;

@syscall("fremovexattr")
pub fn fremovexattr(fd: i32, name: str) i32;

// ── Misc ─────────────────────────────────────────────────────────────────────

@syscall("readahead")
pub fn readahead(fd: i32, offset: i64, count: usize) isize;

// args: pointer to seccomp_data struct
@syscall("seccomp")
pub unsafe fn seccomp(op: u32, flags: u32, args: *u8) i32;

// attr: pointer to union bpf_attr
@syscall("bpf")
pub unsafe fn bpf(cmd: i32, attr: *u8, size: u32) i32;

@syscall("setns")
pub fn setns(fd: i32, nstype: i32) i32;

@syscall("unshare")
pub fn unshare(flags: i32) i32;

@syscall("pivot_root")
pub fn pivot_root(new_root: str, put_old: str) i32;

@syscall("membarrier")
pub fn membarrier(cmd: i32, flags: u32, cpu_id: i32) i32;

// lvec/rvec: pointer to struct iovec[]
@syscall("process_vm_readv")
pub unsafe fn process_vm_readv(pid: i32, lvec: *u8, liovcnt: usize, rvec: *u8, riovcnt: usize, flags: usize) isize;

@syscall("process_vm_writev")
pub unsafe fn process_vm_writev(pid: i32, lvec: *u8, liovcnt: usize, rvec: *u8, riovcnt: usize, flags: usize) isize;
