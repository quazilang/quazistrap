@syscall("chroot")
pub fn chroot(path: str) i32;

// mount / umount2 — require CAP_SYS_ADMIN
@syscall("mount")
pub fn mount(source: str, target: str, fstype: str, mountflags: usize, data: usize) i32;

@syscall("umount2")
pub fn umount2(target: str, flags: i32) i32;

// swap
@syscall("swapon")
pub fn swapon(path: str, swapflags: i32) i32;

@syscall("swapoff")
pub fn swapoff(path: str) i32;

// acct — process accounting (requires CAP_SYS_PACCT)
@syscall("acct")
pub fn acct(filename: str) i32;

// ── Extended attributes ───────────────────────────────────────────────────────

@syscall("setxattr")
pub fn setxattr(path: str, name: str, value: usize, size: usize, flags: i32) i32;

@syscall("lsetxattr")
pub fn lsetxattr(path: str, name: str, value: usize, size: usize, flags: i32) i32;

@syscall("fsetxattr")
pub fn fsetxattr(fd: i32, name: str, value: usize, size: usize, flags: i32) i32;

@syscall("getxattr")
pub fn getxattr(path: str, name: str, value: usize, size: usize) isize;

@syscall("lgetxattr")
pub fn lgetxattr(path: str, name: str, value: usize, size: usize) isize;

@syscall("fgetxattr")
pub fn fgetxattr(fd: i32, name: str, value: usize, size: usize) isize;

@syscall("listxattr")
pub fn listxattr(path: str, list: str, size: usize) isize;

@syscall("llistxattr")
pub fn llistxattr(path: str, list: str, size: usize) isize;

@syscall("flistxattr")
pub fn flistxattr(fd: i32, list: str, size: usize) isize;

@syscall("removexattr")
pub fn removexattr(path: str, name: str) i32;

@syscall("lremovexattr")
pub fn lremovexattr(path: str, name: str) i32;

@syscall("fremovexattr")
pub fn fremovexattr(fd: i32, name: str) i32;

// ── Misc ─────────────────────────────────────────────────────────────────────

@syscall("readahead")
pub fn readahead(fd: i32, offset: i64, count: usize) isize;

// seccomp — sandbox syscall filtering; op: SECCOMP_SET_MODE_STRICT=0
@syscall("seccomp")
pub fn seccomp(op: u32, flags: u32, args: usize) i32;

// bpf — BPF program management
@syscall("bpf")
pub fn bpf(cmd: i32, attr: usize, size: u32) i32;

// setns — join a namespace (fd from /proc/*/ns/*)
@syscall("setns")
pub fn setns(fd: i32, nstype: i32) i32;

@syscall("unshare")
pub fn unshare(flags: i32) i32;

@syscall("pivot_root")
pub fn pivot_root(new_root: str, put_old: str) i32;

// membarrier — memory ordering between threads
@syscall("membarrier")
pub fn membarrier(cmd: i32, flags: u32, cpu_id: i32) i32;

// process_vm_readv / process_vm_writev — cross-process memory access
@syscall("process_vm_readv")
pub fn process_vm_readv(pid: i32, lvec: usize, liovcnt: usize, rvec: usize, riovcnt: usize, flags: usize) isize;

@syscall("process_vm_writev")
pub fn process_vm_writev(pid: i32, lvec: usize, liovcnt: usize, rvec: usize, riovcnt: usize, flags: usize) isize;
