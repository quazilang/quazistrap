// std.io — console I/O
// UTF-8 contract: all str/&str parameters are valid UTF-8.

import std.core.write;
import std.core.read;
import std.core.strlen;
import std.core.malloc;

// @intrinsic("void.write")
// fn write(fd: i32, buf: str, count: usize) isize;

// @intrinsic("void.read")
// fn read(fd: i32, buf: *u8, count: usize) isize;

// @intrinsic("void.strlen")
// fn strlen(s: str) usize;

// @intrinsic("void.malloc")
// unsafe fn malloc(size: usize) *u8;

// ── Writer types ──────────────────────────────────────────────────────────────

pub struct Stdout { fd: i32, }
pub struct Stderr { fd: i32, }

pub fn stdout() Stdout { ret Stdout { fd: 1 }; }
pub fn stderr() Stderr { ret Stderr { fd: 2 }; }

impl Write for Stdout {
    pub fn write(self: Stdout, s: str) void {
        write(1, s, strlen(s));
    }

    pub fn writeln(self: Stdout, s: str) void {
        write(1, s, strlen(s));
        write(1, "\n", 1);
    }

    pub fn writef(self: Stdout, s: str, ...args: any) void {
        write(1, s, strlen(s));
    }

    pub fn writelnf(self: Stdout, s: str, ...args: any) void {
        write(1, s, strlen(s));
        write(1, "\n", 1);
    }
}

impl Write for Stderr {
    pub fn write(self: Stderr, s: str) void {
        write(2, s, strlen(s));
    }

    pub fn writeln(self: Stderr, s: str) void {
        write(2, s, strlen(s));
        write(2, "\n", 1);
    }

    pub fn writef(self: Stderr, s: str, ...args: any) void {
        write(2, s, strlen(s));
    }

    pub fn writelnf(self: Stderr, s: str, ...args: any) void {
        write(2, s, strlen(s));
        write(2, "\n", 1);
    }
}

// ── stdout convenience ────────────────────────────────────────────────────────

pub fn print(s: str, ...args: any) void {
    write(1, s, strlen(s));
}

pub fn println(s: str, ...args: any) void {
    write(1, s, strlen(s));
    write(1, "\n", 1);
}

// ── stderr convenience ────────────────────────────────────────────────────────

pub fn err(s: str, ...args: any) void {
    write(2, s, strlen(s));
}

pub fn errln(s: str, ...args: any) void {
    write(2, s, strlen(s));
    write(2, "\n", 1);
}

// ── arbitrary fd ─────────────────────────────────────────────────────────────

pub fn writeln(fd: i32, s: str) void {
    write(fd, s, strlen(s));
    write(fd, "\n", 1);
}

// ── stdin ─────────────────────────────────────────────────────────────────────

pub unsafe fn read_bytes(buf: *u8, n: usize) isize {
    ret read(0, buf, n);
}

pub unsafe fn read_buf() *u8 {
    var buf: *u8 = malloc(4096);
    read(0, buf, 4095);
    ret buf;
}
