@api("recv")
pub fn recv(s: usize, buf: str, len: i32, flags: i32) i32;

// to: pointer to destination sockaddr
@api("sendto")
pub unsafe fn sendto(s: usize, buf: str, len: i32, flags: i32, to: *u8, tolen: i32) i32;

// from: pointer to sockaddr output; fromlen: pointer to i32 (in/out)
@api("recvfrom")
pub unsafe fn recvfrom(s: usize, buf: str, len: i32, flags: i32, from: *u8, fromlen: *i32) i32;

// optval: pointer to option value buffer
@api("setsockopt")
pub unsafe fn setsockopt(s: usize, level: i32, optname: i32, optval: *u8, optlen: i32) i32;

// optval: pointer to option value output; optlen: pointer to i32 (in/out)
@api("getsockopt")
pub unsafe fn getsockopt(s: usize, level: i32, optname: i32, optval: *u8, optlen: *i32) i32;

// addr: pointer to sockaddr output; addrlen: pointer to i32 (in/out)
@api("getsockname")
pub unsafe fn getsockname(s: usize, addr: *u8, addrlen: *i32) i32;

@api("getpeername")
pub unsafe fn getpeername(s: usize, addr: *u8, addrlen: *i32) i32;

// readfds/writefds/exceptfds: pointer to fd_set; timeout: pointer to TIMEVAL or null
@api("select")
pub unsafe fn select(nfds: i32, readfds: *u8, writefds: *u8, exceptfds: *u8, timeout: *u8) i32;

// argp: pointer to u_long output
@api("ioctlsocket")
pub unsafe fn ioctlsocket(s: usize, cmd: i32, argp: *u32) i32;

// hints: pointer to ADDRINFOA input; result: pointer to ADDRINFOA* output
@api("getaddrinfo")
pub unsafe fn getaddrinfo(node: str, service: str, hints: *u8, result: *u8) i32;

// info: pointer returned by getaddrinfo
@api("freeaddrinfo")
pub unsafe fn freeaddrinfo(info: *u8) void;

@api("getnameinfo")
pub unsafe fn getnameinfo(addr: *u8, addrlen: i32, host: str, host_len: u32, serv: str, serv_len: u32, flags: i32) i32;

// dst: pointer to in_addr or in6_addr output
@api("inet_pton")
pub unsafe fn inet_pton(af: i32, src: str, dst: *u8) i32;

// src: pointer to in_addr or in6_addr input
@api("inet_ntop")
pub unsafe fn inet_ntop(af: i32, src: *u8, dst: str, size: usize) str;

// htons / ntohs — byte order conversion (no pointers)
@api("htons")
pub fn htons(hostshort: u16) u16;

@api("ntohs")
pub fn ntohs(netshort: u16) u16;

@api("htonl")
pub fn htonl(hostlong: u32) u32;

@api("ntohl")
pub fn ntohl(netlong: u32) u32;
