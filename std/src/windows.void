@api("DeleteCriticalSection")
pub fn delete_critical_section(cs: usize) void;

// ── Error ────────────────────────────────────────────────────────────────────

@api("GetLastError")
pub fn get_last_error() u32;

@api("SetLastError")
pub fn set_last_error(err: u32) void;

// flags: FORMAT_MESSAGE_FROM_SYSTEM=0x1000, FORMAT_MESSAGE_IGNORE_INSERTS=0x200
// lang: MAKELANGID(LANG_NEUTRAL, SUBLANG_DEFAULT) = 0x400
@api("FormatMessageA")
pub fn format_message_a(flags: u32, source: usize, msg_id: u32, lang: u32, buf: str, size: u32, args: usize) u32;

// ── Library ──────────────────────────────────────────────────────────────────

@api("LoadLibraryA")
pub fn load_library_a(name: str) usize;

