pub fn get_command_line_a() str;

// returns pointer to null-terminated array of null-terminated strings
@api("GetEnvironmentStringsA")
pub fn get_environment_strings_a() usize;

@api("FreeEnvironmentStringsA")
pub fn free_environment_strings_a(env: usize) i32;

// ── Time ─────────────────────────────────────────────────────────────────────

// st: pointer to SYSTEMTIME { u16 year, month, dow, day, hour, min, sec, ms }
@api("GetSystemTime")
pub fn get_system_time(st: usize) void;

@api("GetLocalTime")
pub fn get_local_time(st: usize) void;

@api("SetSystemTime")
pub fn set_system_time(st: usize) i32;

@api("SetLocalTime")
pub fn set_local_time(st: usize) i32;

// ft: pointer to FILETIME { u32 low, u32 high } — 100-nanosecond intervals since 1601-01-01
@api("GetSystemTimeAsFileTime")
pub fn get_system_time_as_file_time(ft: usize) void;

@api("FileTimeToSystemTime")
pub fn file_time_to_system_time(ft: usize, st: usize) i32;

@api("SystemTimeToFileTime")
pub fn system_time_to_file_time(st: usize, ft: usize) i32;

@api("FileTimeToLocalFileTime")
pub fn file_time_to_local_file_time(utc: usize, local: usize) i32;

// perf counter (use for high-res timing)
@api("QueryPerformanceCounter")
pub fn query_performance_counter(count: usize) i32;

@api("QueryPerformanceFrequency")
pub fn query_performance_frequency(freq: usize) i32;

@api("GetTickCount64")
pub fn get_tick_count64() u64;

// ── Registry ─────────────────────────────────────────────────────────────────
// Predefined keys: HKEY_LOCAL_MACHINE=0x80000002, HKEY_CURRENT_USER=0x80000001
//                  HKEY_CLASSES_ROOT=0x80000000, HKEY_USERS=0x80000003

// access: KEY_READ=0x20019, KEY_WRITE=0x20006, KEY_ALL_ACCESS=0xF003F
@api("RegOpenKeyExA")
pub fn reg_open_key_ex_a(key: usize, sub_key: str, options: u32, access: u32, result: usize) i32;

@api("RegCreateKeyExA")
pub fn reg_create_key_ex_a(key: usize, sub_key: str, reserved: u32, cls: str, options: u32, access: u32, security: usize, result: usize, disposition: usize) i32;

@api("RegCloseKey")
pub fn reg_close_key(key: usize) i32;

// type: REG_SZ=1, REG_DWORD=4, REG_BINARY=3, REG_EXPAND_SZ=2, REG_MULTI_SZ=7
@api("RegQueryValueExA")
pub fn reg_query_value_ex_a(key: usize, value: str, reserved: usize, reg_type: usize, data: usize, cb_data: usize) i32;

@api("RegSetValueExA")
pub fn reg_set_value_ex_a(key: usize, value: str, reserved: u32, reg_type: u32, data: usize, cb_data: u32) i32;

@api("RegDeleteValueA")
pub fn reg_delete_value_a(key: usize, value: str) i32;

@api("RegDeleteKeyA")
pub fn reg_delete_key_a(key: usize, sub_key: str) i32;

@api("RegEnumKeyExA")
pub fn reg_enum_key_ex_a(key: usize, index: u32, name: str, name_size: usize, reserved: usize, cls: str, cls_size: usize, last_write: usize) i32;

@api("RegEnumValueA")
pub fn reg_enum_value_a(key: usize, index: u32, value: str, value_size: usize, reserved: usize, reg_type: usize, data: usize, data_size: usize) i32;

// ── Security & Privileges ────────────────────────────────────────────────────

// access: TOKEN_ADJUST_PRIVILEGES|TOKEN_QUERY=0x28
@api("OpenProcessToken")
pub fn open_process_token(proc: usize, access: u32, token: usize) i32;

@api("OpenThreadToken")
pub fn open_thread_token(thread: usize, access: u32, open_as_self: i32, token: usize) i32;

// luid: pointer to LUID struct (8 bytes)
@api("LookupPrivilegeValueA")
pub fn lookup_privilege_value_a(system: str, name: str, luid: usize) i32;

// privileges: pointer to TOKEN_PRIVILEGES struct
@api("AdjustTokenPrivileges")
pub fn adjust_token_privileges(token: usize, disable_all: i32, new_state: usize, buf_len: u32, prev: usize, ret_len: usize) i32;

@api("GetTokenInformation")
pub fn get_token_information(token: usize, info_class: i32, info: usize, info_len: u32, ret_len: usize) i32;

@api("IsUserAnAdmin")
pub fn is_user_an_admin() i32;

// ── System Info ──────────────────────────────────────────────────────────────

// si: pointer to SYSTEM_INFO struct
@api("GetSystemInfo")
pub fn get_system_info(si: usize) void;

@api("GetNativeSystemInfo")
pub fn get_native_system_info(si: usize) void;

@api("GlobalMemoryStatusEx")
pub fn global_memory_status_ex(stat: usize) i32;

@api("GetComputerNameA")
pub fn get_computer_name_a(buf: str, size: usize) i32;

@api("GetUserNameA")
pub fn get_user_name_a(buf: str, size: usize) i32;

@api("GetVersionExA")
pub fn get_version_ex_a(os_ver: usize) i32;

// ── WinSock2 ─────────────────────────────────────────────────────────────────
// Link with ws2_32.lib.  Call ws_startup() before using any socket function.
// data: pointer to WSADATA struct (at least 400 bytes)
// version: MAKEWORD(2,2) = 0x0202

@api("WSAStartup")
pub fn ws_startup(version: u16, data: usize) i32;

@api("WSACleanup")
pub fn ws_cleanup() i32;

@api("WSAGetLastError")
pub fn ws_get_last_error() i32;

// af: AF_INET=2, AF_INET6=23; type: SOCK_STREAM=1, SOCK_DGRAM=2; proto: IPPROTO_TCP=6, IPPROTO_UDP=17
@api("socket")
pub fn socket(af: i32, stype: i32, protocol: i32) usize;

@api("closesocket")
pub fn closesocket(s: usize) i32;

@api("bind")
pub fn bind(s: usize, addr: usize, addrlen: i32) i32;

@api("listen")
pub fn listen(s: usize, backlog: i32) i32;

@api("accept")
pub fn accept(s: usize, addr: usize, addrlen: usize) usize;

@api("connect")
pub fn connect(s: usize, addr: usize, addrlen: i32) i32;

@api("send")
pub fn send(s: usize, buf: str, len: i32, flags: i32) i32;

@api("recv")
pub fn recv(s: usize, buf: str, len: i32, flags: i32) i32;

@api("sendto")
pub fn sendto(s: usize, buf: str, len: i32, flags: i32, to: usize, tolen: i32) i32;

@api("recvfrom")
pub fn recvfrom(s: usize, buf: str, len: i32, flags: i32, from: usize, fromlen: usize) i32;

@api("setsockopt")
pub fn setsockopt(s: usize, level: i32, optname: i32, optval: usize, optlen: i32) i32;

@api("getsockopt")
pub fn getsockopt(s: usize, level: i32, optname: i32, optval: usize, optlen: usize) i32;

@api("getsockname")
pub fn getsockname(s: usize, addr: usize, addrlen: usize) i32;

@api("getpeername")
pub fn getpeername(s: usize, addr: usize, addrlen: usize) i32;

@api("shutdown")
pub fn shutdown(s: usize, how: i32) i32;

// fds: pointer to fd_set; timeout: pointer to TIMEVAL or null
@api("select")
