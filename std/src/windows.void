// std.windows — Windows Win32 API bindings via @api
// All functions use Win64 calling convention (rcx, rdx, r8, r9).
// Not available on Linux/macOS (@api emits no-op when target is not Windows).
//
// Required libs (add to void.toml [build].flags or linker invocation):
//   kernel32.lib  — handles, process, memory, console, sync, registry
//   user32.lib    — window/message API
//   advapi32.lib  — registry, security, services
//   ws2_32.lib    — WinSock2 networking
//
// Type conventions:
//   HANDLE / HMODULE / HWND / HKEY etc. → usize (opaque pointer-sized)
//   BOOL  → i32 (0 = FALSE, nonzero = TRUE)
//   DWORD → u32
//   WORD  → u16
//   LPSTR / LPCSTR / char* → str (C string pointer)
//   LPVOID / void* → usize
//   SIZE_T → usize
//   UINT / int → i32 or u32 depending on signedness

// ── Handles & Core ───────────────────────────────────────────────────────────

// STD_INPUT_HANDLE  = 0xFFFFFFF6 (4294967286)
// STD_OUTPUT_HANDLE = 0xFFFFFFF5 (4294967285)
// STD_ERROR_HANDLE  = 0xFFFFFFF4 (4294967284)
@api("GetStdHandle")
pub fn get_std_handle(n_std_handle: u32) usize;

@api("CloseHandle")
pub fn close_handle(object: usize) i32;

@api("DuplicateHandle")
pub fn duplicate_handle(src_proc: usize, src: usize, dst_proc: usize, dst: usize, access: u32, inherit: i32, options: u32) i32;

// ── Console I/O ──────────────────────────────────────────────────────────────

// WriteFile — works on files, pipes, consoles, and serial ports
// overlapped: 0 for synchronous
@api("WriteFile")
pub fn write_file(file: usize, buf: str, n_to_write: u32, n_written: usize, overlapped: usize) i32;

@api("ReadFile")
pub fn read_file(file: usize, buf: str, n_to_read: u32, n_read: usize, overlapped: usize) i32;

// WriteConsoleA — console-only; fails on redirected stdout
@api("WriteConsoleA")
pub fn write_console_a(console: usize, buf: str, n_chars: u32, n_written: usize, reserved: usize) i32;

@api("ReadConsoleA")
pub fn read_console_a(console: usize, buf: str, n_chars: u32, n_read: usize, reserved: usize) i32;

@api("FlushFileBuffers")
pub fn flush_file_buffers(file: usize) i32;

// mode: ENABLE_ECHO_INPUT, ENABLE_LINE_INPUT, ENABLE_PROCESSED_INPUT, etc.
@api("GetConsoleMode")
pub fn get_console_mode(console: usize, mode: usize) i32;

@api("SetConsoleMode")
pub fn set_console_mode(console: usize, mode: u32) i32;

@api("SetConsoleTitleA")
pub fn set_console_title_a(title: str) i32;

// attr: combination of FOREGROUND_*/BACKGROUND_* constants
@api("SetConsoleTextAttribute")
pub fn set_console_text_attribute(console: usize, attr: u16) i32;

@api("AllocConsole")
pub fn alloc_console() i32;

@api("FreeConsole")
pub fn free_console() i32;

@api("GetConsoleWindow")
pub fn get_console_window() usize;

// ── File I/O ─────────────────────────────────────────────────────────────────

// access: GENERIC_READ=0x80000000, GENERIC_WRITE=0x40000000
// share: FILE_SHARE_READ=1, FILE_SHARE_WRITE=2
// disposition: CREATE_NEW=1, CREATE_ALWAYS=2, OPEN_EXISTING=3, OPEN_ALWAYS=4, TRUNCATE_EXISTING=5
// flags: FILE_ATTRIBUTE_NORMAL=128, FILE_FLAG_OVERLAPPED=0x40000000
@api("CreateFileA")
pub fn create_file_a(path: str, access: u32, share: u32, security: usize, disposition: u32, flags: u32, template: usize) usize;

@api("GetFileSize")
pub fn get_file_size(file: usize, high: usize) u32;

@api("GetFileSizeEx")
pub fn get_file_size_ex(file: usize, size: usize) i32;

// method: FILE_BEGIN=0, FILE_CURRENT=1, FILE_END=2
@api("SetFilePointer")
pub fn set_file_pointer(file: usize, dist_low: i32, dist_high: usize, method: u32) u32;

@api("SetFilePointerEx")
pub fn set_file_pointer_ex(file: usize, dist: i64, new_ptr: usize, method: u32) i32;

@api("DeleteFileA")
pub fn delete_file_a(path: str) i32;

@api("MoveFileA")
pub fn move_file_a(existing: str, new_path: str) i32;

@api("CopyFileA")
pub fn copy_file_a(existing: str, new_path: str, fail_if_exists: i32) i32;

@api("CreateDirectoryA")
pub fn create_directory_a(path: str, security: usize) i32;

@api("RemoveDirectoryA")
pub fn remove_directory_a(path: str) i32;

@api("GetCurrentDirectoryA")
pub fn get_current_directory_a(buf_len: u32, buf: str) u32;

@api("SetCurrentDirectoryA")
pub fn set_current_directory_a(path: str) i32;

// data: pointer to WIN32_FIND_DATAA struct
@api("FindFirstFileA")
pub fn find_first_file_a(pattern: str, data: usize) usize;

@api("FindNextFileA")
pub fn find_next_file_a(handle: usize, data: usize) i32;

@api("FindClose")
pub fn find_close(handle: usize) i32;

@api("GetTempPathA")
pub fn get_temp_path_a(buf_len: u32, buf: str) u32;

@api("GetTempFileNameA")
pub fn get_temp_file_name_a(path: str, prefix: str, unique: u32, name: str) u32;

@api("GetFileAttributesA")
pub fn get_file_attributes_a(path: str) u32;

@api("SetFileAttributesA")
pub fn set_file_attributes_a(path: str, attrs: u32) i32;

// ── Process ──────────────────────────────────────────────────────────────────

@api("GetCurrentProcess")
pub fn get_current_process() usize;

@api("GetCurrentProcessId")
pub fn get_current_process_id() u32;

@api("GetCurrentThreadId")
pub fn get_current_thread_id() u32;

@api("ExitProcess")
pub fn exit_process(exit_code: u32) void;

// startup_info: pointer to STARTUPINFOA; proc_info: pointer to PROCESS_INFORMATION
// creation_flags: CREATE_NEW_CONSOLE=0x10, CREATE_SUSPENDED=0x4, DETACHED_PROCESS=0x8
@api("CreateProcessA")
pub fn create_process_a(app: str, cmd: str, proc_sec: usize, thread_sec: usize, inherit: i32, flags: u32, env: usize, dir: str, startup: usize, proc_info: usize) i32;

// access: PROCESS_ALL_ACCESS=0x1FFFFF, PROCESS_QUERY_INFORMATION=0x400
@api("OpenProcess")
pub fn open_process(access: u32, inherit: i32, pid: u32) usize;

@api("TerminateProcess")
pub fn terminate_process(proc: usize, exit_code: u32) i32;

@api("GetExitCodeProcess")
pub fn get_exit_code_process(proc: usize, exit_code: usize) i32;

@api("GetExitCodeThread")
pub fn get_exit_code_thread(thread: usize, exit_code: usize) i32;

// milliseconds: INFINITE=0xFFFFFFFF
@api("WaitForSingleObject")
pub fn wait_for_single_object(handle: usize, ms: u32) u32;

@api("WaitForMultipleObjects")
pub fn wait_for_multiple_objects(count: u32, handles: usize, wait_all: i32, ms: u32) u32;

// ── Thread ───────────────────────────────────────────────────────────────────

// stack_size: 0 = default; creation_flags: 0 = run immediately, CREATE_SUSPENDED=4
@api("CreateThread")
pub fn create_thread(security: usize, stack_size: usize, start_routine: usize, param: usize, flags: u32, thread_id: usize) usize;

@api("ExitThread")
pub fn exit_thread(exit_code: u32) void;

@api("GetCurrentThread")
pub fn get_current_thread() usize;

@api("ResumeThread")
pub fn resume_thread(thread: usize) u32;

@api("SuspendThread")
pub fn suspend_thread(thread: usize) u32;

@api("TerminateThread")
pub fn terminate_thread(thread: usize, exit_code: u32) i32;

// priority: THREAD_PRIORITY_NORMAL=0, ABOVE_NORMAL=1, BELOW_NORMAL=-1, HIGHEST=2, LOWEST=-2
@api("SetThreadPriority")
pub fn set_thread_priority(thread: usize, priority: i32) i32;

@api("GetThreadPriority")
pub fn get_thread_priority(thread: usize) i32;

@api("TlsAlloc")
pub fn tls_alloc() u32;

@api("TlsGetValue")
pub fn tls_get_value(index: u32) usize;

@api("TlsSetValue")
pub fn tls_set_value(index: u32, value: usize) i32;

@api("TlsFree")
pub fn tls_free(index: u32) i32;

@api("Sleep")
pub fn sleep(ms: u32) void;

@api("SleepEx")
pub fn sleep_ex(ms: u32, alertable: i32) u32;

// ── Memory ───────────────────────────────────────────────────────────────────

// type: MEM_COMMIT=0x1000, MEM_RESERVE=0x2000, MEM_COMMIT|MEM_RESERVE=0x3000
// protect: PAGE_READWRITE=4, PAGE_READONLY=2, PAGE_EXECUTE_READ=0x20, PAGE_EXECUTE_READWRITE=0x40, PAGE_NOACCESS=1
@api("VirtualAlloc")
pub fn virtual_alloc(addr: usize, size: usize, alloc_type: u32, protect: u32) usize;

// type: MEM_RELEASE=0x8000, MEM_DECOMMIT=0x4000
@api("VirtualFree")
pub fn virtual_free(addr: usize, size: usize, free_type: u32) i32;

@api("VirtualProtect")
pub fn virtual_protect(addr: usize, size: usize, new_protect: u32, old_protect: usize) i32;

@api("VirtualQuery")
pub fn virtual_query(addr: usize, buf: usize, len: usize) usize;

@api("GetProcessHeap")
pub fn get_process_heap() usize;

// flags: HEAP_ZERO_MEMORY=8
@api("HeapAlloc")
pub fn heap_alloc(heap: usize, flags: u32, size: usize) usize;

@api("HeapFree")
pub fn heap_free(heap: usize, flags: u32, mem: usize) i32;

@api("HeapReAlloc")
pub fn heap_realloc(heap: usize, flags: u32, mem: usize, size: usize) usize;

@api("HeapSize")
pub fn heap_size(heap: usize, flags: u32, mem: usize) usize;

@api("HeapCreate")
pub fn heap_create(options: u32, initial: usize, maximum: usize) usize;

@api("HeapDestroy")
pub fn heap_destroy(heap: usize) i32;

// flags: LMEM_FIXED=0, LMEM_ZEROINIT=0x40
@api("LocalAlloc")
pub fn local_alloc(flags: u32, size: usize) usize;

@api("LocalFree")
pub fn local_free(mem: usize) usize;

@api("GlobalAlloc")
pub fn global_alloc(flags: u32, size: usize) usize;

@api("GlobalFree")
pub fn global_free(mem: usize) usize;

// ── Synchronization ──────────────────────────────────────────────────────────

// initial_owner: TRUE=1 if creating thread owns mutex
@api("CreateMutexA")
pub fn create_mutex_a(security: usize, initial_owner: i32, name: str) usize;

@api("OpenMutexA")
pub fn open_mutex_a(access: u32, inherit: i32, name: str) usize;

@api("ReleaseMutex")
pub fn release_mutex(mutex: usize) i32;

// manual_reset: TRUE=1 for manual, FALSE=0 for auto-reset
@api("CreateEventA")
pub fn create_event_a(security: usize, manual_reset: i32, initial_state: i32, name: str) usize;

@api("OpenEventA")
pub fn open_event_a(access: u32, inherit: i32, name: str) usize;

@api("SetEvent")
pub fn set_event(event: usize) i32;

@api("ResetEvent")
pub fn reset_event(event: usize) i32;

@api("PulseEvent")
pub fn pulse_event(event: usize) i32;

@api("CreateSemaphoreA")
pub fn create_semaphore_a(security: usize, initial: i32, maximum: i32, name: str) usize;

@api("ReleaseSemaphore")
pub fn release_semaphore(sem: usize, count: i32, prev: usize) i32;

// cs: pointer to CRITICAL_SECTION (40 bytes on x86-64)
@api("InitializeCriticalSection")
pub fn initialize_critical_section(cs: usize) void;

@api("EnterCriticalSection")
pub fn enter_critical_section(cs: usize) void;

@api("TryEnterCriticalSection")
pub fn try_enter_critical_section(cs: usize) i32;

@api("LeaveCriticalSection")
