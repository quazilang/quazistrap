// std.box — heap-allocated smart pointer Box[T]
import std.core;

@intrinsic("void.array.store")
fn __box_write(base: *u8, idx: usize, val: usize) void;

@intrinsic("void.array.load")
fn __box_read(base: *u8, idx: usize) usize;

pub struct Box[T] {
    ptr: *u8,
}

impl Box[T] {
    pub fn new(val: T) Box[T] {
        var p: *u8;
        unsafe { p = core.malloc(8); }
        __box_write(p, 0, val);
        ret Box { ptr: p };
    }

    pub fn get(self: Box[T]) T {
        ret __box_read(self.ptr, 0);
    }

    pub fn free(self: Box[T]) void {
        unsafe { core.free(self.ptr); }
    }
}
