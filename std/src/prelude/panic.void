// std.panic — panic and panic handler
//
// Default: prints "thread 'main' panicked: <msg>\n" to stderr and exits 101.
//
// Override the handler by defining a function with @panic_handler:
//   @panic_handler
//   fn my_handler(info: PanicInfo) ! { ... }
// The compiler replaces the default with your function automatically.

@intrinsic("void.write")
fn __panic_write(fd: i32, buf: str, count: usize) isize;

@intrinsic("void.strlen")
fn __panic_strlen(s: str) usize;

@intrinsic("void.exit")
fn __panic_exit(code: i32) i32;

pub struct PanicInfo {
    message: str,
}

impl PanicInfo {
    pub fn message(self: PanicInfo) str {
        ret self;
    }
}

pub fn __void_panic_handler(msg: str) ! {
    __panic_write(2, "thread 'main' panicked at '", 27);
    __panic_write(2, msg, __panic_strlen(msg));
    __panic_write(2, "'\nnote: run with VOID_TRACE=1 for a stack trace\n", 48);
    __panic_exit(101);
}

pub fn panic(msg: str, ...args: str) ! {
    __void_panic_handler(msg);
}
