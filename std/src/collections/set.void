// std.collections.set — open-addressing hash set (linear probing, tombstone delete)
// Elements are hashed as raw 64-bit values. Use integer or pointer-stable values.
// Resize at 75% load; initial capacity 16.
import std.core;

@intrinsic("void.array.store")
fn __set_store(base: *u8, idx: usize, val: usize) void;

@intrinsic("void.array.load")
fn __set_load(base: *u8, idx: usize) usize;

// flags slot values: 0 = empty, 1 = used, 2 = tombstone
struct Set[T] {
    keys:  *u8,
    flags: *u8,
    len:   usize,
    cap:   usize,
}

impl Set[T] {
    pub fn new() Set[T] {
        var keys:  *u8;
        var flags: *u8;
        unsafe {
            keys  = core.malloc(128);
            flags = core.malloc(128);
            core.memset(flags, 0, 128);
        }
        ret Set { keys: keys, flags: flags, len: 0, cap: 16 };
    }

    @ignore
    fn __hash(self: Set[T], key: T) usize {
        ret (key * 2654435761) % self.cap;
    }

    pub fn insert(self: Set[T], key: T) Set[T] {
        if (self.len * 4 >= self.cap * 3) {
            ret self.__grow().insert(key);
        }
        var idx: usize = self.__hash(key);
        var probe: usize = 0;
        var first_tomb: usize = self.cap;
        for (probe < self.cap) {
            var f: usize = __set_load(self.flags, idx);
            if (f == 0) {
                var target: usize = idx;
                if (first_tomb < self.cap) {
                    target = first_tomb;
                }
                __set_store(self.flags, target, 1);
                __set_store(self.keys, target, key);
                ret Set { keys: self.keys, flags: self.flags, len: self.len + 1, cap: self.cap };
            }
            if (f == 1) {
                var k: usize = __set_load(self.keys, idx);
                if (k == key) {
                    ret self;
                }
            }
            if (f == 2) {
                if (first_tomb >= self.cap) {
                    first_tomb = idx;
                }
            }
            idx = (idx + 1) % self.cap;
            probe = probe + 1;
        }
        if (first_tomb < self.cap) {
            __set_store(self.flags, first_tomb, 1);
            __set_store(self.keys, first_tomb, key);
            ret Set { keys: self.keys, flags: self.flags, len: self.len + 1, cap: self.cap };
        }
        ret self;
    }

    pub fn contains(self: Set[T], key: T) bool {
        var idx: usize = self.__hash(key);
        var probe: usize = 0;
        for (probe < self.cap) {
            var f: usize = __set_load(self.flags, idx);
            if (f == 0) { ret false; }
            if (f == 1) {
                var k: usize = __set_load(self.keys, idx);
                if (k == key) { ret true; }
            }
            idx = (idx + 1) % self.cap;
            probe = probe + 1;
        }
        ret false;
    }

    pub fn remove(self: Set[T], key: T) Set[T] {
        var idx: usize = self.__hash(key);
        var probe: usize = 0;
        for (probe < self.cap) {
            var f: usize = __set_load(self.flags, idx);
            if (f == 0) { ret self; }
            if (f == 1) {
                var k: usize = __set_load(self.keys, idx);
                if (k == key) {
                    __set_store(self.flags, idx, 2);
                    ret Set { keys: self.keys, flags: self.flags, len: self.len - 1, cap: self.cap };
                }
            }
            idx = (idx + 1) % self.cap;
            probe = probe + 1;
        }
        ret self;
    }

    pub fn len(self: Set[T]) usize {
        ret self.len;
    }

    pub fn free(self: Set[T]) void {
        unsafe {
            core.free(self.keys);
            core.free(self.flags);
        }
    }

    @ignore
    fn __grow(self: Set[T]) Set[T] {
        var new_cap: usize = self.cap * 2;
        var new_keys:  *u8;
        var new_flags: *u8;
        unsafe {
            new_keys  = core.malloc(new_cap * 8);
            new_flags = core.malloc(new_cap * 8);
            core.memset(new_flags, 0, new_cap * 8);
        }
        var new_set: Set[T] = Set { keys: new_keys, flags: new_flags, len: 0, cap: new_cap };
        var i: usize = 0;
        for (i < self.cap) {
            var f: usize = __set_load(self.flags, i);
            if (f == 1) {
                var k: T = __set_load(self.keys, i);
                new_set = new_set.insert(k);
            }
            i = i + 1;
        }
        unsafe {
            core.free(self.keys);
            core.free(self.flags);
        }
        ret new_set;
    }
}
