// std.collections.array — safe generic dynamic array backed by heap memory
import std.core;
import std.traits;

// Internal: write val into base[idx * 8]. @intrinsic bypasses S12.
@intrinsic("void.array.store")
fn __ptr_store(base: *u8, idx: usize, val: usize) void;

// Internal: read base[idx * 8].
@intrinsic("void.array.load")
fn __ptr_load(base: *u8, idx: usize) usize;

struct Array[T] {
    ptr: *u8,
    len: usize,
    cap: usize,
}

impl Array[T] {
    pub fn new() Array[T] {
        var buf: *u8;
        unsafe { buf = core.malloc(64); }
        ret Array { ptr: buf, len: 0, cap: 8 };
    }

    // Array.from([e0, e1, ...]) is handled by the codegen as new() + push each element.
    // This declaration exists for the type checker; its body is never called.
    @ignore
    pub fn from(self: Array[T], items: any) Array[T] {
        ret self;
    }

    pub fn push(self: Array[T], val: T) Array[T] {
        if (self.len >= self.cap) {
            var new_cap: usize = self.cap * 2;
            var new_ptr: *u8;
            unsafe { new_ptr = core.realloc(self.ptr, new_cap * 8); }
            __ptr_store(new_ptr, self.len, val);
            ret Array { ptr: new_ptr, len: self.len + 1, cap: new_cap };
        }
        __ptr_store(self.ptr, self.len, val);
        ret Array { ptr: self.ptr, len: self.len + 1, cap: self.cap };
    }

    pub fn get(self: Array[T], idx: usize) T {
        if (idx >= self.len) {
            core.exit(1);
        }
        ret __ptr_load(self.ptr, idx);
    }

    pub fn len(self: Array[T]) usize {
        ret self.len;
    }

    pub fn free(self: Array[T]) void {
        unsafe { core.free(self.ptr); }
    }
}

impl Index[usize, T] for Array[T] {
    pub fn index(self: Array[T], i: usize) T {
        ret self.get(i);
    }
}
