// std.core — platform-neutral intrinsics
// Import this for cross-platform I/O, memory, and process primitives.
// These lower to the appropriate syscall/Win32/libc call per target at AOT time.
// @no_std disables automatic std availability.

// ── I/O ──────────────────────────────────────────────────────────────────────

@intrinsic("void.write")
pub fn write(fd: i32, buf: str, count: usize) isize;

@intrinsic("void.read")
pub fn read(fd: i32, buf: str, count: usize) isize;

@intrinsic("void.stderr_write")
pub fn stderr_write(buf: str, len: usize) isize;

// ── Process ──────────────────────────────────────────────────────────────────

@intrinsic("void.exit")
pub fn exit(code: i32) i32;

@intrinsic("void.sleep_ms")
pub fn sleep_ms(ms: u64) void;

@intrinsic("void.getenv")
pub fn getenv(name: str) usize;

// ── Memory ───────────────────────────────────────────────────────────────────

@intrinsic("void.malloc")
pub fn malloc(size: usize) usize;

@intrinsic("void.free")
pub fn free(ptr: usize) void;

@intrinsic("void.realloc")
pub fn realloc(ptr: usize, size: usize) usize;

@intrinsic("void.memcpy")
pub fn memcpy(dst: usize, src: usize, n: usize) usize;

@intrinsic("void.memset")
pub fn memset(ptr: usize, val: i32, n: usize) usize;

@intrinsic("void.memmove")
pub fn memmove(dst: usize, src: usize, n: usize) usize;

@intrinsic("void.memcmp")
pub fn memcmp(a: usize, b: usize, n: usize) i32;

// ── String ───────────────────────────────────────────────────────────────────

@intrinsic("void.strlen")
pub fn strlen(s: str) usize;
